---
// Formulaire statique sans backend, envoyé via Web3Forms (https://web3forms.com).
// La clé pointe vers le compte Web3Forms de yummyfoodtrailer@gmail.com — si l'adresse
// de réception doit changer, se reconnecter sur web3forms.com et ajuster dans le dashboard.
const WEB3FORMS_ACCESS_KEY = '06bcfbd6-a51a-4c67-878c-47281f3aafd2';

// Module « commande à emporter ou à livrer » : masqué par défaut, affiché par le script
// uniquement les jours activés dans src/data/commande.json.
import commande from '../data/commande.json';
import contact from '../data/contact.json';

const SUBJECT_CONTACT = 'Nouveau message depuis le site Yummy';
const SUBJECT_COMMANDE = `🛵 NOUVELLE ${commande.libelle.toUpperCase()}`;
// Créneaux acceptés pour l'heure souhaitée, ex. [["11:30","14:00"],["18:00","21:00"]].
const creneaux: string[][] = commande.creneaux ?? [];
const fmtHeure = (h: string) => h.replace(/^0/, '').replace(':00', 'h').replace(':', 'h');
const creneauxTexte = creneaux.map(([a, b]) => `${fmtHeure(a)} – ${fmtHeure(b)}`).join(' ou ');
const lieuRetrait = commande.lieuRetrait?.trim() || '';
const retraitTexte = lieuRetrait ? `Lieu de retrait : ${lieuRetrait}.` : 'Lieu de retrait confirmé lors de notre appel.';
const telHref = `tel:${contact.telephone.replace(/\s+/g, '')}`;
const inputClass =
  'min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark';
---

<div id="formulaire" class="scroll-mt-24">

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-subject-contact={SUBJECT_CONTACT}
  data-subject-commande={SUBJECT_COMMANDE}
  data-libelle={commande.libelle}
  data-creneaux={JSON.stringify(creneaux)}
  class="flex flex-col gap-5 rounded-2xl border border-primary-dark/15 bg-white p-5 shadow-sm md:p-8"
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value={SUBJECT_CONTACT} />
  <input type="hidden" name="commande" value="" disabled />
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" aria-hidden="true" />

  <p class="font-body text-sm text-muted">Tous les champs sont obligatoires, sauf ceux marqués « facultatif ».</p>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="flex min-w-0 flex-col gap-1">
      <label for="name" class="font-body text-base font-semibold text-anthracite">Nom</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark"
      />
    </div>

    <div class="flex min-w-0 flex-col gap-1">
      <label for="email" class="font-body text-base font-semibold text-anthracite">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="flex min-w-0 flex-col gap-1">
      <label for="phone" class="font-body text-base font-semibold text-anthracite">Téléphone</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        class="w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark"
      />
    </div>

    <div class="flex min-w-0 flex-col gap-1">
      <label for="event_type" class="font-body text-base font-semibold text-anthracite">Type d'événement <span class="font-normal text-muted">(facultatif)</span></label>
      <select
        id="event_type"
        name="event_type"
        class="w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark"
      >
        <option value="">Sélectionnez...</option>
        <option value={commande.libelle} data-commande disabled>🛵 {commande.libelle} (fermé aujourd'hui)</option>
        <option value="Mariage">Mariage</option>
        <option value="Anniversaire / fête de famille">Anniversaire / fête de famille</option>
        <option value="Entreprise">Entreprise</option>
        <option value="Festival / marché">Festival / marché</option>
        <option value="Autre">Autre</option>
      </select>
    </div>
  </div>

  <fieldset id="order-panel" hidden disabled class="flex flex-col gap-4 rounded-xl border-2 border-lime bg-mint/60 p-4 md:p-5">
    <legend class="rounded-full bg-lime px-3 py-1 font-heading text-sm font-bold text-primary-dark">🛵 {commande.libelle}</legend>
    <p class="font-body text-sm text-anthracite">Choisissez vos quantités :</p>
    <ul class="flex flex-col gap-2">
      {
        commande.produits.map((p) => (
          <li class="flex items-center justify-between gap-3 rounded-lg bg-white px-3 py-2 shadow-sm">
            <span class="font-heading font-semibold text-primary-dark">
              <span aria-hidden="true">{p.emoji}</span> {p.nom}
            </span>
            <span class="flex items-center gap-2">
              <button type="button" data-step="-1" class="h-8 w-8 rounded-full bg-mint font-heading text-lg font-bold text-primary-dark hover:bg-lime" aria-label={`Retirer un ${p.nom}`}>−</button>
              <input
                type="number"
                data-nom={p.nom}
                min="0"
                max="50"
                value="0"
                inputmode="numeric"
                aria-label={`Quantité ${p.nom}`}
                class="w-12 rounded-lg border border-anthracite/20 py-1 text-center font-body text-sm font-bold"
              />
              <button type="button" data-step="1" class="h-8 w-8 rounded-full bg-primary font-heading text-lg font-bold text-cream hover:bg-primary-dark" aria-label={`Ajouter un ${p.nom}`}>+</button>
            </span>
          </li>
        ))
      }
    </ul>
    <p id="order-error" hidden class="font-body text-sm font-bold text-red-700">Ajoutez au moins un produit à votre commande.</p>
    <div role="radiogroup" aria-labelledby="mode-label" class="flex flex-col gap-2">
      <p id="mode-label" class="font-body text-base font-semibold text-anthracite">À emporter ou à livrer ?</p>
      <div class="grid grid-cols-2 gap-2">
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border-2 border-anthracite/15 bg-white px-3 py-2 text-left leading-tight font-heading text-sm font-semibold text-primary-dark shadow-sm has-[:checked]:border-primary has-[:checked]:bg-lime">
          <input type="radio" name="mode" value="À emporter (retrait)" required class="accent-primary" />
          <span class="flex flex-col"><span class="whitespace-nowrap">🛍️ À emporter</span><span class="font-body text-xs font-normal">retrait sur place</span></span>
        </label>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border-2 border-anthracite/15 bg-white px-3 py-2 text-left leading-tight font-heading text-sm font-semibold text-primary-dark shadow-sm has-[:checked]:border-primary has-[:checked]:bg-lime">
          <input type="radio" name="mode" value="À livrer" required class="accent-primary" />
          <span class="flex flex-col"><span class="whitespace-nowrap">🛵 À livrer</span><span class="font-body text-xs font-normal">à votre adresse</span></span>
        </label>
      </div>
      <p id="retrait-info" hidden class="font-body text-xs text-anthracite">📍 {retraitTexte}</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <div id="adresse-wrap" class="flex flex-col gap-1 md:col-span-2">
        <label for="adresse" class="font-body text-base font-semibold text-anthracite">Adresse de livraison</label>
        <input id="adresse" name="adresse" type="text" autocomplete="street-address" class={inputClass} />
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="heure" class="font-body text-base font-semibold text-anthracite">Heure souhaitée</label>
        <input id="heure" name="heure" type="time" required min={creneaux[0]?.[0]} max={creneaux.at(-1)?.[1]} step="300" aria-describedby="heure-aide" class={inputClass} />
        <p id="heure-aide" class="font-body text-xs text-muted">Créneaux : {creneauxTexte}</p>
      </div>
    </div>
    <p id="heure-error" hidden class="font-body text-sm font-bold text-red-700">Choisissez une heure dans nos créneaux : {creneauxTexte}.</p>
    <p class="font-body text-xs text-muted">Nous vous recontacterons pour valider la commande. Pensez à indiquer votre téléphone.</p>
    <p class="font-body text-xs text-anthracite">
      Aussi par téléphone (<a href={telHref} class="font-bold text-primary hover:underline">{contact.telephone}</a>),
      <a href={contact.reseaux.facebookUrl} target="_blank" rel="noopener" class="font-bold text-primary hover:underline">Messenger</a>
      et <a href={contact.reseaux.instagramUrl} target="_blank" rel="noopener" class="font-bold text-primary hover:underline">Instagram</a>.
    </p>
  </fieldset>

  <div class="flex min-w-0 flex-col gap-1">
    <label for="message" class="font-body text-base font-semibold text-anthracite">Message<span id="message-optional" hidden class="font-normal text-muted"> (facultatif)</span></label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base focus:border-primary-dark"
    ></textarea>
  </div>

  <p id="form-error" hidden role="alert" class="rounded-lg border-2 border-red-700 bg-red-50 px-4 py-3 font-body text-base text-red-800">
    L'envoi n'a pas abouti. Vérifiez votre connexion et réessayez, ou appelez-nous au {contact.telephone}. Votre message est conservé.
  </p>

  <div class="flex flex-col gap-3">
    <button type="submit" class="btn-dark w-full text-lg disabled:cursor-wait disabled:opacity-70 sm:w-auto sm:self-start">
      <span data-submit-label>Envoyer</span>
    </button>
    <p class="font-body text-sm text-muted">
      Vos coordonnées servent uniquement à répondre à votre demande
      (<a href="/politique-de-confidentialite" class="lien">politique de confidentialité</a>).
    </p>
  </div>
  <p id="form-status" class="sr-only" aria-live="polite"></p>
</form>

<div id="form-success" hidden tabindex="-1" class="flex flex-col items-center gap-3 rounded-2xl border-2 border-primary-dark bg-white p-8 text-center shadow-sm">
  <span class="text-4xl" aria-hidden="true">✅</span>
  <h2 class="font-heading text-2xl font-bold text-primary-dark">Demande bien prise en compte !</h2>
  <p id="success-commande" hidden class="font-body text-anthracite">
    Nous vous recontacterons pour valider la commande<span id="success-mode"></span>.
  </p>
  <p id="success-retrait" hidden class="font-body text-sm text-anthracite">📍 {retraitTexte}</p>
  <p id="success-contact" class="font-body text-anthracite">Merci pour votre message, nous vous répondrons dès que possible.</p>
  <p class="font-body text-sm text-muted">
    Une question ? Appelez-nous au
    <a href={telHref} class="font-bold text-primary hover:underline">{contact.telephone}</a>
  </p>
</div>
</div>

<script>
  import { ordersOpen } from '../scripts/commande';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const select = form.querySelector<HTMLSelectElement>('#event_type')!;
  const option = select.querySelector<HTMLOptionElement>('option[data-commande]')!;
  const panel = document.getElementById('order-panel') as HTMLFieldSetElement;
  const message = form.querySelector<HTMLTextAreaElement>('#message')!;
  const summary = form.querySelector<HTMLInputElement>('input[name="commande"]')!;
  const subject = form.querySelector<HTMLInputElement>('input[name="subject"]')!;
  const qtyInputs = [...panel.querySelectorAll<HTMLInputElement>('input[type="number"]')];
  const modes = [...panel.querySelectorAll<HTMLInputElement>('input[name="mode"]')];
  const adresse = form.querySelector<HTMLInputElement>('#adresse')!;
  const heure = form.querySelector<HTMLInputElement>('#heure')!;
  const creneaux: string[][] = JSON.parse(form.dataset.creneaux || '[]');
  const heureError = document.getElementById('heure-error')!;

  const mode = () => modes.find((m) => m.checked)?.value ?? '';
  const isDelivery = () => mode() === 'À livrer';
  const syncMode = () => {
    const livraison = isDelivery();
    adresse.required = livraison;
    adresse.disabled = !livraison && mode() !== '';
    document.getElementById('adresse-wrap')!.hidden = !livraison && mode() !== '';
    document.getElementById('retrait-info')!.hidden = livraison || mode() === '';
  };
  modes.forEach((m) => m.addEventListener('change', syncMode));

  // L'heure (HH:MM) doit tomber dans un des créneaux de commande.json (bornes incluses).
  const inSlot = (v: string) => !creneaux.length || creneaux.some(([a, b]) => v >= a && v <= b);
  const checkHeure = () => {
    const ok = !heure.value || inSlot(heure.value);
    heure.setCustomValidity(ok ? '' : heureError.textContent?.trim() ?? 'Heure hors créneaux');
    heureError.hidden = ok;
    return ok;
  };
  heure.addEventListener('input', checkHeure);
  heure.addEventListener('change', checkHeure);

  const isOrder = () => !panel.disabled;

  const syncOrder = () => {
    const on = select.value === form.dataset.libelle;
    panel.hidden = panel.disabled = !on;
    summary.disabled = !on;
    message.required = !on;
    document.getElementById('message-optional')!.hidden = !on;
    subject.value = (on ? form.dataset.subjectCommande : form.dataset.subjectContact) ?? '';
  };

  if (ordersOpen()) {
    option.hidden = option.disabled = false;
    option.textContent = `🛵 ${option.value} (aujourd'hui)`;
    if (new URLSearchParams(location.search).has('commande')) select.value = option.value;
    syncOrder();
  }
  select.addEventListener('change', syncOrder);

  panel.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-step]');
    if (!btn) return;
    const input = btn.parentElement!.querySelector<HTMLInputElement>('input')!;
    input.value = String(Math.min(50, Math.max(0, (Number(input.value) || 0) + Number(btn.dataset.step))));
    document.getElementById('order-error')!.hidden = true;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isOrder()) {
      const lignes = qtyInputs.filter((i) => Number(i.value) > 0).map((i) => `${i.value} × ${i.dataset.nom}`);
      if (!lignes.length) {
        document.getElementById('order-error')!.hidden = false;
        return;
      }
      if (!checkHeure()) {
        heure.reportValidity();
        return;
      }
      const lieu = isDelivery() ? `livraison : ${adresse.value.trim()}` : 'retrait';
      summary.value = `${mode()} — ${lignes.join(', ')} — ${heure.value} (${lieu})`;
      subject.value = `🛵 NOUVELLE COMMANDE ${mode().replace(/ \(.*\)$/, '').toUpperCase()} — ${heure.value}`;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = document.getElementById('form-status')!;
    button.disabled = true;
    buttonLabel.textContent = 'Envoi en cours…';
    status.textContent = 'Envoi en cours';
    document.getElementById('form-error')!.hidden = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.message);
      document.getElementById('success-commande')!.hidden = !isOrder();
      document.getElementById('success-mode')!.textContent = isOrder() ? (isDelivery() ? ' et l\'heure de livraison' : ' et le retrait') : '';
      document.getElementById('success-retrait')!.hidden = !isOrder() || isDelivery();
      document.getElementById('success-contact')!.hidden = isOrder();
      form.hidden = true;
      const success = document.getElementById('form-success')!;
      success.hidden = false;
      document.dispatchEvent(new CustomEvent('yummy:formulaire', { detail: isOrder() ? 'commande' : 'contact' }));
      success.focus({ preventScroll: true });
      success.scrollIntoView({ block: 'center' });
    } catch {
      document.getElementById('form-error')!.hidden = false;
      buttonLabel.textContent = 'Réessayer';
      status.textContent = "Échec de l'envoi";
      button.disabled = false;
    }
  });
</script>
