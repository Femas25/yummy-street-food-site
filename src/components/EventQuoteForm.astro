---
// Demande de devis pour un événement privé, envoyée via Web3Forms (même compte que ContactForm).
// Le champ caché « source » indique quelle campagne a amené la demande (lien ?src=… dans les e-mails).
const WEB3FORMS_ACCESS_KEY = '06bcfbd6-a51a-4c67-878c-47281f3aafd2';

const field =
  'w-full min-w-0 rounded-lg border border-anthracite/20 bg-white px-3 py-2 font-body text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary';
const label = 'font-body text-sm font-semibold text-anthracite';
---

<form
  data-stats="devis"
  id="devis"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="flex flex-col gap-4 rounded-xl border border-primary/20 bg-white p-6 shadow-sm md:p-8"
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="🔴 NOUVELLE DEMANDE DE DEVIS — événement privé" />
  <input type="hidden" name="source" id="source" value="" />
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

  <div class="grid gap-4 md:grid-cols-2">
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-name" class={label}>Nom</label>
      <input id="q-name" name="name" type="text" required autocomplete="name" class={field} />
    </div>
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-email" class={label}>Email</label>
      <input id="q-email" name="email" type="email" required autocomplete="email" class={field} />
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-phone" class={label}>Téléphone</label>
      <input id="q-phone" name="phone" type="tel" autocomplete="tel" class={field} />
    </div>
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-type" class={label}>Type d'événement</label>
      <select id="q-type" name="event_type" required class={field}>
        <option value="">Sélectionnez...</option>
        <option>Mariage</option>
        <option>Séminaire / repas de cohésion / événement d'entreprise</option>
        <option>Fête du personnel / family day</option>
        <option>Anniversaire</option>
        <option>Cousinade / communion / baptême / fête de famille</option>
        <option>Association / école / club / brocante</option>
        <option>Autre</option>
      </select>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-date" class={label}>Date (même approximative)</label>
      <input id="q-date" name="date_evenement" type="date" class={field} />
    </div>
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-guests" class={label}>Nombre d'invités</label>
      <input id="q-guests" name="nombre_invites" type="number" min="1" inputmode="numeric" class={field} />
    </div>
    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-place" class={label}>Commune / lieu</label>
      <input id="q-place" name="lieu" type="text" placeholder="Ville ou adresse de l'événement" class={field} />
    </div>
  </div>

  <div class="flex min-w-0 flex-col gap-1">
    <label for="q-message" class={label}>Votre projet en quelques mots</label>
    <textarea
      id="q-message"
      name="message"
      rows="4"
      placeholder="Ambiance, horaires, contraintes du lieu, budget indicatif..."
      class={field}
    ></textarea>
  </div>

  <button
    type="submit"
    class="mt-2 rounded-full bg-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream transition-colors hover:bg-primary-dark"
  >
    Recevoir ma proposition
  </button>
  <p class="text-center font-body text-xs text-anthracite/60">Sans engagement — nous revenons vers vous avec une proposition sur mesure.</p>
</form>

<script>
  // Garde la trace de la campagne d'origine (ex. lien ?src=mail-mariage dans un e-mail de prospection).
  const src = new URLSearchParams(window.location.search).get('src');
  const sourceInput = document.getElementById('source') as HTMLInputElement | null;
  if (sourceInput) sourceInput.value = src ?? 'direct';
</script>
