---
// Demande de devis pour un événement privé, envoyée via Web3Forms (même compte que ContactForm).
// Le champ caché « source » indique quelle campagne a amené la demande (lien ?src=… dans les e-mails).
// Envoi en arrière-plan (fetch) avec états en français : envoi en cours, succès, erreur + réessayer.
import contact from '../data/contact.json';

const WEB3FORMS_ACCESS_KEY = '06bcfbd6-a51a-4c67-878c-47281f3aafd2';
const telHref = `tel:${contact.telephone.replace(/\s+/g, '')}`;

const field =
  'w-full min-w-0 min-h-[44px] rounded-lg border border-anthracite/60 bg-white px-3 py-2 font-body text-base text-anthracite focus:border-primary-dark disabled:bg-cream disabled:text-muted';
const label = 'font-body text-base font-semibold text-anthracite';
const opt = '<span class="font-normal text-muted">(facultatif)</span>';
const check = 'flex min-h-[44px] cursor-pointer items-center gap-2 font-body text-sm text-anthracite';
---

<div data-form-wrap="devis">
  <form
    id="devis-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    data-tel={contact.telephone}
    class="flex flex-col gap-5 rounded-2xl border border-primary-dark/15 bg-white p-5 shadow-sm md:p-8"
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value="🔴 NOUVELLE DEMANDE DE DEVIS — événement privé" />
    <input type="hidden" name="source" id="source" value="" />
    <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" aria-hidden="true" />

    <p class="font-body text-sm text-muted">Tous les champs sont obligatoires, sauf ceux marqués « facultatif ».</p>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-name" class={label}>Nom</label>
        <input id="q-name" name="name" type="text" required autocomplete="name" class={field} />
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-email" class={label}>E-mail</label>
        <input id="q-email" name="email" type="email" required autocomplete="email" inputmode="email" class={field} />
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-phone" class={label}>Téléphone</label>
        <input id="q-phone" name="phone" type="tel" autocomplete="tel" required class={field} />
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-type" class={label}>Type d'événement</label>
        <select id="q-type" name="event_type" required class={field}>
          <option value="">Sélectionnez…</option>
          <option>Mariage</option>
          <option>Séminaire / repas de cohésion / événement d'entreprise</option>
          <option>Fête du personnel / family day</option>
          <option>Anniversaire</option>
          <option>Cousinade / communion / baptême / fête de famille</option>
          <option>Association / école / club / brocante</option>
          <option>Autre</option>
        </select>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-date" class={label}>Date de l'événement <Fragment set:html={opt} /></label>
        <input id="q-date" name="date_evenement" type="date" class={field} />
        <label class={check}>
          <input type="checkbox" data-a-preciser="q-date" class="h-5 w-5 accent-primary-dark" />
          Date encore à préciser
        </label>
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="q-guests" class={label}>Nombre d'invités <Fragment set:html={opt} /></label>
        <input id="q-guests" name="nombre_invites" type="number" min="1" inputmode="numeric" class={field} />
        <label class={check}>
          <input type="checkbox" data-a-preciser="q-guests" class="h-5 w-5 accent-primary-dark" />
          Nombre encore à préciser
        </label>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-place" class={label}>Commune ou lieu <Fragment set:html={opt} /></label>
      <input id="q-place" name="lieu" type="text" placeholder="Ville ou adresse de l'événement" class={field} />
    </div>

    <div class="flex min-w-0 flex-col gap-1">
      <label for="q-message" class={label}>Votre projet en quelques mots <Fragment set:html={opt} /></label>
      <textarea id="q-message" name="message" rows="4" placeholder="Ambiance, horaires, contraintes du lieu, budget indicatif…" class={field}></textarea>
    </div>

    <p data-form-error hidden role="alert" class="rounded-lg border-2 border-red-700 bg-red-50 px-4 py-3 font-body text-base text-red-800"></p>

    <div class="flex flex-col gap-3">
      <button type="submit" data-submit class="btn-dark w-full text-lg disabled:cursor-wait disabled:opacity-70 sm:w-auto sm:self-start">
        <span data-submit-label>Recevoir ma proposition</span>
      </button>
      <p class="font-body text-sm text-muted">
        Sans engagement. Vos coordonnées servent uniquement à répondre à votre demande
        (<a href="/politique-de-confidentialite" class="lien">politique de confidentialité</a>).
      </p>
    </div>
    <p data-form-status class="sr-only" aria-live="polite"></p>
  </form>

  <div data-form-success hidden tabindex="-1" class="flex flex-col items-start gap-3 rounded-2xl border-2 border-primary-dark bg-white p-6 md:p-8">
    <p class="kicker text-primary">Demande envoyée</p>
    <h3 class="font-heading text-2xl font-semibold">Merci, votre demande est bien partie !</h3>
    <p class="font-body text-base text-anthracite">
      Nous revenons vers vous avec une proposition adaptée à votre événement.
    </p>
    <p class="font-body text-base text-anthracite">
      Une précision à ajouter ? Appelez-nous au <a href={telHref} class="lien">{contact.telephone}</a>.
    </p>
  </div>
</div>

<script>
  // Garde la trace de la campagne d'origine (ex. lien ?src=mail-mariage dans un e-mail de prospection).
  const src = new URLSearchParams(window.location.search).get('src');
  const sourceInput = document.getElementById('source') as HTMLInputElement | null;
  if (sourceInput) sourceInput.value = src ?? 'direct';

  const form = document.getElementById('devis-form') as HTMLFormElement;
  const wrap = form.closest<HTMLElement>('[data-form-wrap]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
  const status = form.querySelector<HTMLElement>('[data-form-status]')!;
  const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
  const success = wrap.querySelector<HTMLElement>('[data-form-success]')!;
  const tel = form.dataset.tel ?? '';
  // Validation gérée par le script (messages en français) ; sans JavaScript, le navigateur valide lui-même.
  form.noValidate = true;

  // « À préciser » : désactive le champ et envoie « À préciser » à la place.
  form.querySelectorAll<HTMLInputElement>('[data-a-preciser]').forEach((box) => {
    const input = document.getElementById(box.dataset.aPreciser!) as HTMLInputElement;
    box.addEventListener('change', () => {
      input.disabled = box.checked;
      if (box.checked) input.value = '';
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    if (!form.checkValidity()) {
      const premier = form.querySelector<HTMLElement>(':invalid');
      errorBox.textContent = 'Merci de compléter les champs obligatoires : nom, e-mail valide, téléphone et type d\'événement.';
      errorBox.hidden = false;
      form.reportValidity();
      premier?.focus();
      return;
    }

    const data = new FormData(form);
    form.querySelectorAll<HTMLInputElement>('[data-a-preciser]').forEach((box) => {
      const input = document.getElementById(box.dataset.aPreciser!) as HTMLInputElement;
      if (box.checked) data.set(input.name, 'À préciser');
    });

    button.disabled = true;
    buttonLabel.textContent = 'Envoi en cours…';
    status.textContent = 'Envoi en cours';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);
      form.hidden = true;
      success.hidden = false;
      success.focus();
      document.dispatchEvent(new CustomEvent('yummy:formulaire', { detail: 'devis' }));
    } catch {
      errorBox.textContent = `L'envoi n'a pas abouti. Vérifiez votre connexion et réessayez${tel ? `, ou appelez-nous au ${tel}` : ''}. Vos informations sont conservées.`;
      errorBox.hidden = false;
      buttonLabel.textContent = 'Réessayer';
      status.textContent = 'Échec de l\'envoi';
      button.disabled = false;
    }
  });
</script>
