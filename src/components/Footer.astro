---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import contact from '../data/contact.json';
import Mail from './icons/Mail.astro';
import Phone from './icons/Phone.astro';
import Instagram from './icons/Instagram.astro';
import Facebook from './icons/Facebook.astro';

const year = new Date().getFullYear();
---

<footer class="bg-primary-dark text-cream">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
    <div class="flex flex-col items-start gap-3">
      <Image src={logo} alt="Yummy Street Food" width={1500} height={868} class="h-14 w-auto" />
      <p class="font-body text-sm text-mint">
        Food truck — Végétal • Local • Gourmand.
      </p>
    </div>

    <div>
      <h3 class="mb-3 font-heading text-sm font-bold uppercase tracking-wide text-lime">Navigation</h3>
      <ul class="flex flex-col gap-2 font-body text-sm">
        <li><a href="/menu" class="hover:text-lime">Nos propositions</a></li>
        <li><a href="/localisation" class="hover:text-lime">Où nous trouver</a></li>
        <li><a href="/contact" class="hover:text-lime">Contact</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 font-heading text-sm font-bold uppercase tracking-wide text-lime">Contact</h3>
      <ul class="flex flex-col gap-2 font-body text-sm">
        <li class="flex items-center gap-2">
          <Mail class="h-4 w-4 shrink-0 text-lime" />
          <a href={`mailto:${contact.email}`} class="hover:text-lime">{contact.email}</a>
        </li>
        <li class="flex items-center gap-2">
          <Phone class="h-4 w-4 shrink-0 text-lime" />
          <a href={`tel:${contact.telephone.replace(/\s+/g, '')}`} class="hover:text-lime">{contact.telephone}</a>
        </li>
        <li class="flex items-center gap-2">
          <Instagram class="h-4 w-4 shrink-0 text-lime" />
          <a href={contact.reseaux.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-lime">{contact.reseaux.instagram}</a>
        </li>
        <li class="flex items-center gap-2">
          <Facebook class="h-4 w-4 shrink-0 text-lime" />
          <a href={contact.reseaux.facebookUrl} target="_blank" rel="noopener noreferrer" class="hover:text-lime">{contact.reseaux.facebook}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-primary/40 px-4 py-4 text-center font-body text-xs text-mint/70">
    <p>© {year} Yummy Street Food — Tous droits réservés.</p>
    <p class="mt-1 flex flex-wrap justify-center gap-x-3 gap-y-1">
      <a href="/mentions-legales" class="hover:text-lime hover:underline">Mentions légales</a>
      <span aria-hidden="true">·</span>
      <a href="/politique-de-confidentialite" class="hover:text-lime hover:underline">Politique de confidentialité</a>
    </p>
  </div>
</footer>
