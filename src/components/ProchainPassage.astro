---
// Carte « Prochain passage » : même source que l'agenda (src/data/evenements.json via src/lib/agenda.ts).
// Le HTML est calculé au build, puis le script le recalcule dans le navigateur à l'heure belge réelle :
// une sortie en cours reste affichée jusqu'à sa fin (même après minuit), puis la suivante prend le relais.
import contact from '../data/contact.json';
import { prochainPassage, dateLongue, jourRelatif, itineraire, lienPlans, lienWaze } from '../lib/agenda';

interface Props {
  /** Affiche le lien vers l'agenda complet (accueil). */
  lienAgenda?: boolean;
  class?: string;
}
const { lienAgenda = false, class: className = '' } = Astro.props;

const maintenant = Date.now();
const p = prochainPassage(maintenant);
const label = p ? jourRelatif(p, maintenant) || 'Prochain passage' : 'Prochain passage';
---

<section id="prochain-passage" aria-labelledby="pp-titre" data-prochain-passage class={`card overflow-hidden ${className}`}>
  <div class="flex items-center gap-2 bg-primary-dark px-5 py-3 text-cream sm:px-6">
    <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-lime"></span>
    </span>
    <h2 id="pp-titre" class="kicker text-cream" data-pp-label>{label}</h2>
  </div>

  <div class="px-5 py-5 sm:px-6 sm:py-6" data-pp-plein hidden={!p}>
    <p class="font-heading text-2xl font-semibold capitalize-first text-primary-dark sm:text-[1.7rem]" data-pp-date>
      {p ? dateLongue(p.date, maintenant) : ''}
    </p>
    <p class="mt-1 font-heading text-lg font-medium text-primary-dark" data-pp-titre>{p?.titre}</p>
    <dl class="mt-3 grid gap-2 font-body text-base text-anthracite">
      <div class="flex gap-2">
        <dt class="w-20 shrink-0 font-semibold text-muted">Lieu</dt>
        <dd data-pp-lieu>{p ? `${p.lieu}${p.commune && !p.lieu.includes(p.commune) ? `, ${p.commune}` : ''}` : ''}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="w-20 shrink-0 font-semibold text-muted">Horaires</dt>
        <dd data-pp-horaires>{p?.horaires}</dd>
      </div>
    </dl>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={p?.adresse ? itineraire(p.adresse) : '#'} rel="noopener" class="btn-dark" data-pp-itineraire hidden={!p?.adresse}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        Itinéraire
      </a>
      <span class="flex items-center gap-1 font-body text-sm text-muted" data-pp-autres hidden={!p?.adresse}>
        ou
        <a href={p?.adresse ? lienPlans(p.adresse) : '#'} rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1" data-pp-plans>Plans</a>
        ·
        <a href={p?.adresse ? lienWaze(p.adresse) : '#'} rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1" data-pp-waze>Waze</a>
      </span>
    </div>
  </div>

  <div class="px-5 py-5 sm:px-6 sm:py-6" data-pp-vide hidden={!!p}>
    <p class="font-heading text-xl font-semibold text-primary-dark">Aucun passage annoncé pour le moment</p>
    <p class="mt-2 font-body text-base text-muted">
      Nos prochaines dates sont aussi annoncées sur
      <a href={contact.reseaux.instagramUrl} target="_blank" rel="noopener noreferrer" class="lien">Instagram</a> et
      <a href={contact.reseaux.facebookUrl} target="_blank" rel="noopener noreferrer" class="lien">Facebook</a>.
    </p>
  </div>

  {
    lienAgenda && (
      <div class="border-t border-primary-dark/10 px-5 py-3 sm:px-6">
        <a href="/localisation" class="lien inline-flex min-h-[44px] items-center font-body">Voir toutes les dates →</a>
      </div>
    )
  }
</section>

<style>
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>

<script>
  import { prochainPassage, dateLongue, jourRelatif, itineraire, lienPlans, lienWaze } from '../lib/agenda';

  const rafraichir = () => {
    const maintenant = Date.now();
    const p = prochainPassage(maintenant);
    document.querySelectorAll<HTMLElement>('[data-prochain-passage]').forEach((carte) => {
      const $ = <T extends HTMLElement>(sel: string) => carte.querySelector<T>(sel)!;
      $('[data-pp-plein]').hidden = !p;
      $('[data-pp-vide]').hidden = !!p;
      $('[data-pp-label]').textContent = p ? jourRelatif(p, maintenant) || 'Prochain passage' : 'Prochain passage';
      if (!p) return;
      $('[data-pp-date]').textContent = dateLongue(p.date, maintenant);
      $('[data-pp-titre]').textContent = p.titre;
      $('[data-pp-lieu]').textContent = `${p.lieu}${p.commune && !p.lieu.includes(p.commune) ? `, ${p.commune}` : ''}`;
      $('[data-pp-horaires]').textContent = p.horaires;
      const aAdresse = !!p.adresse;
      $('[data-pp-itineraire]').hidden = !aAdresse;
      $('[data-pp-autres]').hidden = !aAdresse;
      if (aAdresse) {
        $<HTMLAnchorElement>('[data-pp-itineraire]').href = itineraire(p.adresse!);
        $<HTMLAnchorElement>('[data-pp-plans]').href = lienPlans(p.adresse!);
        $<HTMLAnchorElement>('[data-pp-waze]').href = lienWaze(p.adresse!);
      }
    });
  };
  rafraichir();
  setInterval(rafraichir, 60_000);
</script>
