---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

const navItems = [
  { href: '/', label: 'Accueil' },
  { href: '/menu', label: 'Nos propositions' },
  { href: '/localisation', label: 'Où nous trouver' },
  { href: '/evenements-prives', label: 'Événements privés' },
];

// Normalise les chemins (avec/sans slash final) pour que la mise en avant de la
// page active fonctionne quel que soit le format d'URL renvoyé par l'hébergeur.
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isContact = currentPath === '/contact';
---

<header id="site-header" class="sticky top-0 z-50 bg-primary-dark text-cream shadow-[0_1px_0_rgba(250,245,234,0.08)]">
  <div class="container-y flex h-16 items-center gap-3 md:h-20">
    <a href="/" class="flex shrink-0 items-center" aria-label="Yummy Street Food, accueil">
      <Image src={logo} alt="" width={1500} height={868} widths={[200, 400]} sizes="120px" loading="eager" class="h-11 w-auto md:h-14" />
    </a>

    <nav aria-label="Navigation principale" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class="flex min-h-[44px] items-center rounded-full px-3.5 font-heading text-[0.95rem] font-medium text-cream transition-colors hover:bg-cream/10 aria-[current=page]:bg-cream/10 aria-[current=page]:text-lime lg:px-4"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/contact"
      aria-current={isContact ? 'page' : undefined}
      class="btn-lime btn-sm ml-auto md:ml-2"
    >
      Contact
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-cream hover:bg-cream/10 md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="sr-only">Menu</span>
      <svg data-icon="open" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg data-icon="close" viewBox="0 0 24 24" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="menu-mobile" aria-label="Navigation principale" hidden class="border-t border-cream/10 bg-primary-dark md:hidden">
    <ul class="container-y flex flex-col py-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class="flex min-h-[48px] items-center rounded-xl px-3 font-heading text-lg font-medium text-cream hover:bg-cream/10 aria-[current=page]:text-lime"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/galerie" aria-current={currentPath === '/galerie' ? 'page' : undefined} class="flex min-h-[48px] items-center rounded-xl px-3 font-heading text-lg font-medium text-cream hover:bg-cream/10 aria-[current=page]:text-lime">
          Galerie photos
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Menu mobile : bouton à état (aria-expanded), fermeture par Échap avec retour du focus sur le bouton.
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('menu-mobile');
  const setOpen = (open: boolean, restoreFocus = false) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
