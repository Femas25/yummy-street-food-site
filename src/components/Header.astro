---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Leaf from './icons/Leaf.astro';
import Wrap from './icons/Wrap.astro';
import Burger from './icons/Burger.astro';

const navItems = [
  { href: '/', label: 'Accueil' },
  { href: '/menu', label: 'Nos propositions' },
  { href: '/localisation', label: 'Où nous trouver' },
];

// Normalise les chemins (avec/sans slash final) pour que la mise en avant de la
// page active fonctionne quel que soit le format d'URL renvoyé par l'hébergeur.
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<header id="site-header" class="sticky top-0 z-50 border-b border-cream/0 bg-primary-dark text-cream transition-[padding,box-shadow,border-color] duration-300">
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <Leaf class="leaf-deco absolute -left-4 -top-6 w-14 opacity-70 md:w-16" style="--rot:-16deg; --float-delay: 0s" />
    <Leaf class="leaf-deco absolute -bottom-7 right-[6%] w-12 opacity-60 md:right-[16%] md:w-16" style="--rot:14deg; --float-delay: 1.1s" />
    <Leaf class="leaf-deco hidden md:absolute md:block md:-top-5 md:right-[38%] md:w-20 md:opacity-25" style="--rot:-6deg; --float-delay: 2.2s" />
    <Wrap class="leaf-deco absolute -bottom-4 left-[42%] hidden w-12 opacity-25 sm:block md:w-14" style="--rot:10deg; --float-delay: 1.6s" />
    <Burger class="leaf-deco absolute -bottom-5 left-[8%] hidden w-11 opacity-25 sm:block md:w-14" style="--rot:-9deg; --float-delay: 0.9s" />
    <Burger class="leaf-deco hidden w-16 opacity-15 lg:block lg:absolute lg:-top-6 lg:right-[24%]" style="--rot:8deg; --float-delay: 2s" />
  </div>

  <div
    class="relative z-10 mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 transition-[padding] duration-300 md:flex-nowrap md:py-3"
    id="header-inner"
  >
    <a href="/" class="group flex items-center">
      <Image
        src={logo}
        alt="Yummy Street Food"
        width={1500}
        height={868}
        class="h-11 w-auto origin-left transition-transform duration-300 ease-out group-hover:-rotate-1 group-hover:scale-105 md:h-14"
      />
      <span class="sr-only">Yummy Street Food</span>
    </a>

    <a
      href="/contact"
      aria-current={currentPath === '/contact' ? 'page' : undefined}
      class="group ml-auto flex items-center gap-2 rounded-full bg-lime px-4 py-2 font-heading text-xs font-bold uppercase tracking-wide text-primary-dark shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-lime/90 hover:shadow-md md:order-3 md:px-5 md:text-[0.85rem]"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-4 w-4 transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 5h16v13a1 1 0 0 1-1 1H8l-4 3V6a1 1 0 0 1 1-1Z" />
        <path d="M8 9h8M8 12.5h5" stroke-linecap="round" />
      </svg>
      Contact
    </a>

    <nav class="order-3 w-full md:order-2 md:w-auto md:flex-1">
      <ul class="flex flex-wrap items-center justify-center gap-1 md:flex-nowrap md:justify-center">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class="group relative flex items-center rounded-full px-2.5 py-1.5 font-heading text-xs font-semibold tracking-wide text-cream transition-all duration-200 hover:bg-cream/10 aria-[current=page]:bg-cream/15 aria-[current=page]:text-lime aria-[current=page]:shadow-[inset_0_1px_2px_rgba(0,0,0,0.15)] sm:text-sm md:px-3.5 md:py-2 md:text-[0.85rem]"
              >
                <span class="transition-transform duration-200 group-hover:-translate-y-0.5">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  #site-header.is-scrolled {
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.35);
    border-color: rgba(248, 246, 242, 0.08);
  }

  #site-header.is-scrolled #header-inner {
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }
</style>

<script>
  const header = document.getElementById('site-header');

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
