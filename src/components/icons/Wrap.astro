---
// Icône wrap/tacos en ligne, avec une petite touche de verdure — même esprit graphique que Leaf.astro.
interface Props {
  class?: string;
  style?: string;
}

const { class: className = '', style = '' } = Astro.props;
---

<svg viewBox="0 0 200 200" class={className} style={style} aria-hidden="true" focusable="false" fill="none">
  <path
    d="M56 46 C110 46 158 94 158 148 C158 162 146 162 132 156 C100 142 70 110 58 74 C52 62 48 46 56 46 Z"
    stroke="#F8F6F2"
    stroke-width="8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path d="M66 70 C92 84 112 104 126 130" stroke="#F8F6F2" stroke-width="5" stroke-linecap="round" stroke-dasharray="1 14" />
  <path d="M78 58 C100 72 118 90 130 112" stroke="#F8F6F2" stroke-width="5" stroke-linecap="round" stroke-dasharray="1 14" />
