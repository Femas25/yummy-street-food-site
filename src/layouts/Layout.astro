---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import contact from '../data/contact.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} | Yummy Street Food`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'Yummy Street Food',
  alternateName: ['Yummy', 'Yumi Street Food', 'Yumi'],
  description: 'Food truck de street-food végétale, locale et gourmande, basé à Virton en Belgique.',
  url: Astro.site?.toString(),
  image: new URL('/favicon.png', Astro.site).toString(),
  telephone: contact.telephone,
  email: contact.email,
  servesCuisine: 'Street food végétale',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Virton',
    addressRegion: 'Luxembourg',
    addressCountry: 'BE',
  },
  sameAs: [contact.reseaux.instagramUrl, contact.reseaux.facebookUrl],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#083E23" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={new URL('/favicon.png', Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Lato:wght@400;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
      );

      document.querySelectorAll('.reveal, .reveal-scale').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
