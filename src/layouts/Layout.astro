---
import Header from '../components/Header.astro';
import OrderBanner from '../components/OrderBanner.astro';
import Footer from '../components/Footer.astro';
import Statistiques from '../components/Statistiques.astro';
import contact from '../data/contact.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Titre complet (remplace « {title} | Yummy Street Food »), ex. pour l'accueil. */
  fullTitle?: string;
  /** Image Open Graph (chemin dans public/), 1200 × 630. */
  ogImage?: string;
}

const { title, description, fullTitle, ogImage = '/og-yummy.jpg' } = Astro.props;
const pageTitle = fullTitle ?? `${title} | Yummy Street Food`;

// URL canonique SANS slash final (comme le sitemap et les liens internes) : /menu et non /menu/.
const path = Astro.url.pathname.replace(/\/+$/, '').replace(/\.html$/, '') || '/';
const canonicalURL = new URL(path, Astro.site).toString();
const site = new URL('/', Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

// L'entreprise (activité ambulante basée à Virton). Les passages sur les marchés sont décrits à part,
// en événements schema.org, sur la page « Où nous trouver » (même source : src/data/evenements.json).
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  '@id': `${site}#entreprise`,
  name: 'Yummy Street Food',
  alternateName: ['Yummy', 'Yumi Street Food', 'Yumi'],
  description: 'Food truck de street food végétale basé à Virton (Belgique), présent sur les marchés et événements de Gaume et du sud de la province de Luxembourg.',
  url: site,
  logo: new URL('/favicon.png', Astro.site).toString(),
  image: ogImageURL,
  telephone: contact.telephone,
  email: contact.email,
  servesCuisine: ['Street food', 'Végétarien', 'Végétal'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Virton',
    addressRegion: 'Luxembourg',
    addressCountry: 'BE',
  },
  areaServed: [
    { '@type': 'City', name: 'Virton' },
    { '@type': 'City', name: 'Arlon' },
    { '@type': 'AdministrativeArea', name: 'Gaume' },
    { '@type': 'AdministrativeArea', name: 'Province de Luxembourg' },
  ],
  sameAs: [contact.reseaux.instagramUrl, contact.reseaux.facebookUrl],
};
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#083E23" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yummy Street Food" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La remorque verte Yummy Street Food, hayon ouvert" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Lato:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only z-[100] rounded-full bg-lime px-4 py-2 font-heading font-semibold text-primary-dark focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Aller au contenu
    </a>
    <Header />
    <OrderBanner />
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <Statistiques />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
      );

      document.querySelectorAll('.reveal, .reveal-scale').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
