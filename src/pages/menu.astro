---
// Nos propositions : pour ajouter une photo, l'importer ici (ex. import monPlat from '../assets/menu/mon-plat.jpg';)
// puis l'ajouter au tableau `creations` : { src: monPlat, alt: 'Description du plat' }.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Trailer from '../components/icons/Trailer.astro';
import Leaf from '../components/icons/Leaf.astro';
import sandwichLegumes from '../assets/menu/sandwich-legumes-truck.jpg';
import bowlVegetal from '../assets/menu/bowl-vegetal-fleurs.jpg';
import tacoLegumes from '../assets/menu/taco-legumes-truck.jpg';

const creations: { src: ImageMetadata; alt: string }[] = [
  { src: sandwichLegumes, alt: 'Sandwich garni de légumes grillés, cornichons et oignons rouges, devant le truck Yummy Street Food' },
  { src: bowlVegetal, alt: 'Bowl végétal avec tomates cerises, carottes grillées, salade et fleurs comestibles' },
  { src: tacoLegumes, alt: 'Pain garni de légumes épicés, crème et oignons rouges, devant le truck Yummy Street Food' },
];

const aManger = [
  { emoji: '🥙', nom: 'Pita', desc: 'Pain pita généreusement garni' },
  { emoji: '🍔', nom: 'Burger', desc: 'Le burger version végétale' },
  { emoji: '🌯', nom: 'Wrap', desc: 'Roulé, frais et gourmand' },
  { emoji: '🍲', nom: 'Soupe', desc: 'Légumes du potager' },
  { emoji: '🥗', nom: 'Bowl', desc: 'Un bol plein de bonnes choses' },
];

const aBoire = [
  { emoji: '🥛', nom: 'Kéfir', desc: 'Boisson fermentée' },
  { emoji: '🥤', nom: 'Loumonade cola', desc: 'Limonade brassée à Gouvy' },
  { emoji: '🥤', nom: 'Loumonade pomme-cerise', desc: 'Limonade brassée à Gouvy' },
  { emoji: '💧', nom: 'Valvert', desc: 'Eau de source' },
];
---

<Layout
  title="Nos propositions"
  description="Découvrez nos propositions culinaires de Yummy Street Food : des recettes végétales préparées à partir de légumes locaux et de saison."
>
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <Leaf class="leaf-deco absolute left-1 top-4 w-12 opacity-45 sm:w-14 md:left-6 md:w-16 md:opacity-60" style="--rot:12deg; --float-delay: 0s" />
      <Leaf class="leaf-deco absolute bottom-10 right-1 w-12 opacity-40 sm:w-16 md:right-6 md:w-20 md:opacity-55" style="--rot:-10deg; --float-delay: 1.4s" />
      <Leaf class="leaf-deco absolute bottom-0 left-0 hidden w-28 opacity-20 md:block lg:w-36" style="--rot:4deg; --float-delay: 2.6s" />
      <Trailer class="leaf-deco absolute right-1 top-6 w-20 opacity-70 sm:w-24 md:right-8 md:w-32 md:opacity-90" style="--rot:-6deg; --float-delay: 0.7s" />
    </div>

    <section class="relative z-10 mx-auto max-w-6xl px-4 py-16">
      <h1 class="reveal mb-2 text-center font-heading text-3xl font-extrabold text-primary-dark md:text-4xl">Nos propositions</h1>
      <p class="reveal mb-12 text-center font-body text-anthracite/70" style="--reveal-delay:80ms">
        Un aperçu de ce qui sort du truck — recettes végétales, gourmandes et pleines de couleurs.
      </p>

      <div class="reveal-scale mb-16 rounded-2xl bg-white p-6 shadow-lg md:p-10">
        <h2 class="mb-8 text-center font-heading text-2xl font-bold text-primary-dark md:text-3xl">Aperçu de nos propositions</h2>
        <div class="grid gap-10 md:grid-cols-2">
          <div>
            <h3 class="mb-4 border-b-2 border-mint pb-2 font-heading text-lg font-bold uppercase tracking-wide text-primary-dark">À manger</h3>
            <ul class="flex flex-col gap-4">
              {aManger.map((item) => (
                <li class="flex items-center gap-4">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mint text-2xl">{item.emoji}</span>
                  <div>
                    <p class="font-heading text-base font-bold text-primary-dark">{item.nom}</p>
                    <p class="font-body text-sm text-anthracite/70">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="mb-4 border-b-2 border-mint pb-2 font-heading text-lg font-bold uppercase tracking-wide text-primary-dark">À boire</h3>
            <ul class="flex flex-col gap-4">
              {aBoire.map((item) => (
                <li class="flex items-center gap-4">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mint text-2xl">{item.emoji}</span>
                  <div>
                    <p class="font-heading text-base font-bold text-primary-dark">{item.nom}</p>
                    <p class="font-body text-sm text-anthracite/70">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
            <div class="mt-6 flex items-center justify-center gap-2 rounded-full bg-primary px-4 py-3 text-center font-heading text-sm font-bold text-cream">
              🌿 Légumes du potager local et de saison
            </div>
          </div>
        </div>
      </div>

      {
        creations.length > 0 ? (
          <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            {creations.map((c, i) => (
              <button
                type="button"
                class="creation-thumb reveal-scale group overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
                style={`--reveal-delay:${i * 70}ms`}
                aria-label={`Agrandir la photo : ${c.alt}`}
              >
                <Image src={c.src} alt={c.alt} class="aspect-square w-full object-cover saturate-[1.15] transition-transform duration-500 group-hover:scale-110" widths={[300, 600, 1200]} sizes="(min-width: 768px) 25vw, 50vw" />
              </button>
            ))}
          </div>
        ) : (
          <div class="reveal-scale mx-auto max-w-xl rounded-2xl bg-white/80 p-8 text-center shadow-xl">
            <p class="mb-2 font-heading text-xl font-bold text-primary-dark">Nos propositions arrivent bientôt</p>
            <p class="font-body text-anthracite/80">
              Les photos de nos recettes seront bientôt ici. En attendant, suivez-nous sur Instagram et Facebook pour ne rien rater.
            </p>
          </div>
        )
      }
    </section>
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-anthracite/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Photo en plein écran"
  >
    <button
      id="lightbox-close"
      type="button"
      aria-label="Fermer"
      class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-cream/10 text-cream transition-colors hover:bg-cream/20"
    >
      ✕
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[85vh] max-w-full scale-95 rounded-2xl object-contain opacity-0 shadow-2xl transition-all duration-200"
    />
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  function largestFromSrcset(img: HTMLImageElement) {
    const srcset = img.getAttribute('srcset');
    if (!srcset) return img.currentSrc || img.src;
    const candidates = srcset.split(',').map((entry) => {
      const [url, width] = entry.trim().split(/\s+/);
      return { url, width: parseInt(width, 10) || 0 };
    });
    candidates.sort((a, b) => b.width - a.width);
    return candidates[0]?.url ?? img.currentSrc ?? img.src;
  }

  function openLightbox(img: HTMLImageElement) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = largestFromSrcset(img);
    lightboxImg.alt = img.alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    requestAnimationFrame(() => {
      lightboxImg.classList.remove('scale-95', 'opacity-0');
      lightboxImg.classList.add('scale-100', 'opacity-100');
    });
    document.body.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.classList.add('scale-95', 'opacity-0');
    lightboxImg.classList.remove('scale-100', 'opacity-100');
    document.body.classList.remove('overflow-hidden');
    setTimeout(() => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }, 200);
  }

  document.querySelectorAll<HTMLButtonElement>('.creation-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const img = thumb.querySelector('img');
      if (img) openLightbox(img);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
