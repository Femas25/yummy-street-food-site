---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import contact from '../data/contact.json';
import Mail from '../components/icons/Mail.astro';
import Phone from '../components/icons/Phone.astro';
import Instagram from '../components/icons/Instagram.astro';
import Facebook from '../components/icons/Facebook.astro';

const telHref = `tel:${contact.telephone.replace(/\s+/g, '')}`;
const canaux = [
  { titre: 'Téléphone', texte: contact.telephone, href: telHref, Icone: Phone, externe: false },
  { titre: 'E-mail', texte: contact.email, href: `mailto:${contact.email}`, Icone: Mail, externe: false },
  { titre: 'Instagram', texte: contact.reseaux.instagram, href: contact.reseaux.instagramUrl, Icone: Instagram, externe: true },
  { titre: 'Facebook', texte: contact.reseaux.facebook, href: contact.reseaux.facebookUrl, Icone: Facebook, externe: true },
];
---

<Layout
  title="Contact"
  description="Contactez Yummy Street Food : téléphone, e-mail, Instagram, Facebook et formulaire de contact. Demande de devis pour vos événements privés."
>
  <section class="bg-primary-dark text-cream">
    <div class="container-y py-10 md:py-12">
      <p class="kicker text-lime">Contact</p>
      <h1 class="mt-2 font-heading text-4xl font-semibold text-cream md:text-5xl">Nous contacter</h1>
      <p class="mt-3 max-w-prose font-body text-lg text-mint">Une question, un événement à organiser ? Écrivez-nous ou appelez-nous directement.</p>
    </div>
  </section>

  <div class="container-y grid grid-cols-[minmax(0,1fr)] gap-10 py-10 md:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:items-start lg:gap-14">
    <div class="flex flex-col gap-6">
      <ul class="card divide-y divide-primary-dark/10">
        {
          canaux.map(({ titre, texte, href, Icone, externe }) => (
            <li>
              <a
                href={href}
                {...(externe ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="flex min-h-[64px] items-center gap-4 px-5 py-3 hover:bg-mint"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary-dark text-lime">
                  <Icone class="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block font-heading text-sm font-semibold uppercase tracking-wide text-muted">{titre}</span>
                  <span class="block font-body text-base font-semibold text-primary-dark [overflow-wrap:anywhere]">{texte}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="card border-t-4 border-lime p-5 md:p-6" aria-labelledby="evt-titre">
        <h2 id="evt-titre" class="font-heading text-xl font-semibold">Un événement privé ?</h2>
        <p class="mt-2 font-body text-base text-anthracite">
          Mariage, anniversaire, fête de famille, événement d'entreprise : le truck Yummy se déplace et adapte son offre à
          votre lieu, votre nombre d'invités et votre budget.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/evenements-prives#formules" class="btn-outline btn-sm">Formules</a>
          <a href="/evenements-prives#devis" class="btn-lime btn-sm">Demander un devis</a>
        </div>
      </aside>
    </div>

    <section aria-labelledby="form-titre">
      <h2 id="form-titre" class="mb-4 font-heading text-2xl font-semibold md:text-3xl">Envoyer un message</h2>
      <ContactForm />
    </section>
  </div>
</Layout>
