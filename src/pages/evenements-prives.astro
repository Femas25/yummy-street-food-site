---
// Page de conversion pour l'événementiel privé : c'est l'URL à mettre dans les e-mails de prospection
// (ajouter ?src=nom-campagne pour savoir d'où vient chaque demande de devis).
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EventQuoteForm from '../components/EventQuoteForm.astro';
import contact from '../data/contact.json';
import remorquePhoto from '../assets/truck/remorque-yummy.jpg';
import boulettesSauceYaourt from '../assets/menu/boulettes-sauce-yaourt.jpg';
import burgerBetterave from '../assets/menu/burger-betterave.jpg';
import pitaGarniSauceBlanche from '../assets/menu/pita-garni-sauce-blanche.jpg';
import bowlsVegetauxFleurs from '../assets/menu/bowls-vegetaux-fleurs.jpg';

const occasions = [
  { emoji: '💍', titre: 'Mariages', desc: "Vin d'honneur, repas, service de fin de soirée… et même le brunch du lendemain." },
  { emoji: '🏢', titre: 'Entreprises', desc: "Séminaires, repas de cohésion, fêtes du personnel, family days, portes ouvertes." },
  { emoji: '🎂', titre: 'Anniversaires & familles', desc: 'Anniversaires, cousinades, communions, baptêmes, retrouvailles entre amis.' },
  { emoji: '🎪', titre: 'Associations & écoles', desc: 'Fancy-fairs, brocantes, fêtes de village, clubs sportifs, soirées associatives.' },
];

const formules = [
  {
    titre: 'La Complète',
    contenu: ['5 starters végétaux', '1 plat street food', '+ Dessert en option'],
    desc: 'Le grand jeu : on ouvre avec cinq starters, puis un burger ou une pita. Un dessert pour finir en douceur, si vous le souhaitez.',
    image: burgerBetterave,
    alt: 'Burger à la betterave, salade et sauce',
    pos: '50% 55%',
  },
  {
    titre: 'La Gourmande',
    contenu: ['3 starters végétaux', '1 plat street food', '+ Dessert en option'],
    desc: 'Le bon équilibre : un apéro qui donne envie et un vrai repas, avec ou sans dessert.',
    image: boulettesSauceYaourt,
    alt: 'Boulettes végétales en bouchées apéritives avec sauce au yaourt et aux herbes',
    pos: '50% 40%',
  },
  {
    titre: 'L’Essentielle',
    contenu: ['1 plat street food', '1 dessert'],
    desc: 'Un burger ou une pita, et un dessert : simple, généreux, efficace.',
    image: pitaGarniSauceBlanche,
    alt: 'Pita garni de protéines végétales, tomate, oignon rouge, salade et sauce blanche',
    pos: '55% 42%',
  },
];

const etapes = [
  { n: '1', titre: 'Vous nous décrivez votre projet', desc: 'Date, lieu, nombre d’invités : deux minutes avec le formulaire ci-dessous.' },
  { n: '2', titre: 'Nous vous recontactons avec nos propositions', desc: 'Un menu de saison adapté à votre événement et à votre budget.' },
  { n: '3', titre: 'Le jour J, on arrive avec la remorque', desc: 'On cuisine sur place, vous profitez de vos invités.' },
];

const atouts = [
  'Légumes de saison, de notre potager',
  'Des produits bio et locaux autant que possible',
  'Recettes 100 % végétales et gourmandes — tout le monde se régale',
  'Boissons locales : kéfir, Loumonade de Gouvy, eau Valvert',
  'Une remorque verte qui fait son effet dans le décor',
];
---

<Layout
  title="Événements privés : mariages, entreprises, anniversaires"
  description="Food truck végétal pour vos événements privés, partout où vous êtes : mariages, séminaires, fêtes du personnel, anniversaires. Prestation sur mesure : starters, plats street food et desserts."
>
  <section class="bg-primary-dark text-cream">
    <div class="container-y grid items-center gap-8 py-10 md:grid-cols-[1.1fr_1fr] md:gap-12 md:py-16">
      <div>
        <p class="kicker text-lime">Événements privés</p>
        <h1 class="mt-3 font-heading text-[2.1rem] font-semibold leading-[1.1] text-cream sm:text-5xl">
          Votre événement, version street food du potager.
        </h1>
        <p class="mt-5 max-w-prose font-body text-lg leading-relaxed text-mint">
          Mariage, séminaire, fête du personnel ou anniversaire : la remorque Yummy vient jusqu'à vous, où que soit votre
          événement, avec une cuisine végétale, locale et gourmande.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#devis" class="btn-lime">Demander un devis</a>
          <a href="#formules" class="btn-outline-light">Voir les formules</a>
        </div>
        <p class="mt-4 font-body text-base text-mint">
          Ou appelez-nous : <a href={`tel:${contact.telephone.replace(/\s+/g, '')}`} class="whitespace-nowrap font-semibold text-cream underline underline-offset-4 hover:text-lime">{contact.telephone}</a>
        </p>
      </div>
      <Image
        src={remorquePhoto}
        alt="La remorque Yummy Street Food, hayon ouvert et menu du jour à l'ardoise"
        class="aspect-[4/3] w-full rounded-3xl object-cover object-[35%_70%] shadow-2xl md:aspect-[5/6] md:object-[50%_72%]"
        quality={72}
        widths={[480, 640, 800, 1080]}
        sizes="(min-width: 1152px) 520px, (min-width: 768px) 45vw, calc(100vw - 2rem)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="py-12 md:py-14" aria-labelledby="occasions-titre">
    <div class="container-y">
      <h2 id="occasions-titre" class="font-heading text-3xl font-semibold md:text-4xl">Pour quelles occasions ?</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          occasions.map((o) => (
            <li class="card p-5">
              <p class="text-3xl" aria-hidden="true">{o.emoji}</p>
              <h3 class="mt-2 font-heading text-xl font-semibold">{o.titre}</h3>
              <p class="mt-1 font-body text-base text-muted">{o.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="formules" class="bg-mint py-12 md:py-16" aria-labelledby="formules-titre">
    <div class="container-y">
      <p class="kicker text-primary-dark">Nos formules</p>
      <h2 id="formules-titre" class="mt-1 font-heading text-3xl font-semibold md:text-4xl">Une prestation sur mesure</h2>
      <p class="mt-3 max-w-prose font-body text-lg text-anthracite">Trois formules pour démarrer, à adapter à votre nombre d'invités, à la saison et à votre budget. Tarifs sur devis.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          formules.map((f) => (
            <article class="card flex flex-col overflow-hidden">
              <Image src={f.image} alt={f.alt} class="aspect-[4/3] w-full object-cover" style={`object-position:${f.pos}`} widths={[400, 640, 800]} sizes="(min-width: 768px) 33vw, calc(100vw - 2rem)" quality={68} />
              <div class="flex flex-1 flex-col gap-3 p-5">
                <h3 class="font-heading text-2xl font-semibold">{f.titre}</h3>
                <ul class="flex flex-col gap-2 border-y border-primary-dark/10 py-3">
                  {f.contenu.map((c) => (
                    <li class="flex items-center gap-2 font-body text-base text-anthracite">
                      <span
                        class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm font-bold ${c.startsWith('+') ? 'border-2 border-dashed border-primary text-primary' : 'bg-primary-dark text-cream'}`}
                        aria-hidden="true"
                      >
                        {c.startsWith('+') ? '+' : '✓'}
                      </span>
                      <span class={c.startsWith('+') ? 'italic text-muted' : 'font-semibold'}>{c.replace(/^\+ /, '')}</span>
                    </li>
                  ))}
                </ul>
                <p class="font-body text-base text-muted">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-6 max-w-prose font-body text-base text-anthracite">
        Starters seuls pour un vin d'honneur, service en fin de soirée, brunch du lendemain de mariage, lunch pour vos équipes ? Tout est possible : dites-le-nous dans le formulaire.
      </p>
      <a href="#devis" class="btn-dark mt-6">Demander un devis</a>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-y grid gap-10 md:grid-cols-2 md:gap-14">
      <div>
        <h2 class="font-heading text-3xl font-semibold">Pourquoi Yummy ?</h2>
        <ul class="mt-5 flex flex-col gap-3">
          {
            atouts.map((a) => (
              <li class="flex items-start gap-3 font-body text-lg">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-dark text-sm text-lime" aria-hidden="true">✓</span>
                {a}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-heading text-3xl font-semibold">Comment ça se passe ?</h2>
        <ol class="mt-5 flex flex-col gap-4">
          {
            etapes.map((e) => (
              <li class="flex gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime font-heading text-lg font-semibold text-primary-dark" aria-hidden="true">{e.n}</span>
                <div>
                  <p class="font-heading text-lg font-semibold text-primary-dark">{e.titre}</p>
                  <p class="font-body text-base text-muted">{e.desc}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <Image
          src={bowlsVegetauxFleurs}
          alt="Deux bowls végétaux avec couscous, lentilles, radis, tomates et fleurs comestibles"
          class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover object-[55%_62%]"
          widths={[480, 800]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
        />
      </div>
    </div>
  </section>

  <section id="devis" class="border-t border-primary-dark/10 bg-paper py-12 md:py-16" aria-labelledby="devis-titre">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 id="devis-titre" class="font-heading text-3xl font-semibold md:text-4xl">Demandez votre proposition</h2>
      <p class="mt-3 font-body text-lg text-anthracite">
        Même si la date ou le nombre d'invités ne sont pas encore fixés. Ou appelez-nous au <a class="lien whitespace-nowrap" href={`tel:${contact.telephone.replace(/\s+/g, '')}`}>{contact.telephone}</a>.
      </p>
      <div class="mt-6">
        <EventQuoteForm />
      </div>
    </div>
  </section>
</Layout>
