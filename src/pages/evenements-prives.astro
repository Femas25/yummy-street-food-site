---
// Page de conversion pour l'événementiel privé : c'est l'URL à mettre dans les e-mails de prospection
// (ajouter ?src=nom-campagne pour savoir d'où vient chaque demande de devis).
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EventQuoteForm from '../components/EventQuoteForm.astro';
import Leaf from '../components/icons/Leaf.astro';
import Trailer from '../components/icons/Trailer.astro';
import contact from '../data/contact.json';
import remorquePhoto from '../assets/truck/remorque-yummy.jpg';
import boulettesSauceYaourt from '../assets/menu/boulettes-sauce-yaourt.jpg';
import burgerBetterave from '../assets/menu/burger-betterave.jpg';
import pitaGarniSauceBlanche from '../assets/menu/pita-garni-sauce-blanche.jpg';

const occasions = [
  { emoji: '💍', titre: 'Mariages', desc: "Vin d'honneur, repas, service de fin de soirée… et même le brunch du lendemain." },
  { emoji: '🏢', titre: 'Entreprises', desc: "Séminaires, repas de cohésion, fêtes du personnel, family days, portes ouvertes." },
  { emoji: '🎂', titre: 'Anniversaires & familles', desc: 'Anniversaires, cousinades, communions, baptêmes, retrouvailles entre amis.' },
  { emoji: '🎪', titre: 'Associations & écoles', desc: 'Fancy-fairs, brocantes, fêtes de village, clubs sportifs, soirées associatives.' },
];

const formules = [
  {
    titre: 'La Complète',
    contenu: ['5 starters végétaux', '1 plat street food', '+ Dessert en option'],
    desc: 'Le grand jeu : on ouvre avec cinq starters, puis un burger ou une pita. Un dessert pour finir en douceur, si vous le souhaitez.',
    image: burgerBetterave,
    alt: 'Burger à la betterave, salade et sauce',
  },
  {
    titre: 'La Gourmande',
    contenu: ['3 starters végétaux', '1 plat street food', '+ Dessert en option'],
    desc: 'Le bon équilibre : un apéro qui donne envie et un vrai repas, avec ou sans dessert.',
    image: boulettesSauceYaourt,
    alt: 'Boulettes végétales en bouchées apéritives avec sauce au yaourt et aux herbes',
  },
  {
    titre: 'L’Essentielle',
    contenu: ['1 plat street food', '1 dessert'],
    desc: 'Un burger ou une pita, et un dessert : simple, généreux, efficace.',
    image: pitaGarniSauceBlanche,
    alt: 'Pita garni de protéines végétales, tomate, oignon rouge, salade et sauce blanche',
  },
];

const etapes = [
  { n: '1', titre: 'Vous nous décrivez votre projet', desc: 'Date, lieu, nombre d’invités : deux minutes avec le formulaire ci-dessous.' },
  { n: '2', titre: 'Nous vous recontactons avec nos propositions', desc: 'Un menu de saison adapté à votre événement et à votre budget.' },
  { n: '3', titre: 'Le jour J, on arrive avec la remorque', desc: 'On cuisine sur place, vous profitez de vos invités.' },
];

const atouts = [
  'Légumes de saison cultivés dans notre potager',
  'Des produits bio et locaux autant que possible',
  'Recettes 100 % végétales et gourmandes — tout le monde se régale',
  'Boissons locales : kéfir, Loumonade de Gouvy, eau Valvert',
  'Une remorque verte qui fait son effet dans le décor',
];
---

<Layout
  title="Événements privés : mariages, entreprises, anniversaires"
  description="Food truck végétal pour vos événements privés, partout où vous êtes : mariages, séminaires, fêtes du personnel, anniversaires. Prestation sur mesure : starters, plats street food et desserts."
>
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <Leaf class="leaf-deco absolute left-1 top-4 w-12 opacity-45 sm:w-14 md:left-6 md:w-16 md:opacity-60" style="--rot:12deg; --float-delay: 0s" />
      <Leaf class="leaf-deco absolute bottom-24 right-1 w-12 opacity-40 sm:w-16 md:right-6 md:w-20 md:opacity-55" style="--rot:-10deg; --float-delay: 1.4s" />
      <Trailer class="leaf-deco absolute right-1 top-6 w-20 opacity-70 sm:w-24 md:right-8 md:w-32 md:opacity-90" style="--rot:-6deg; --float-delay: 0.7s" />
    </div>

    <section class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-2">
      <div>
        <p class="reveal mb-3 inline-block rounded-full bg-lime px-3 py-1 font-heading text-xs font-bold uppercase tracking-wide text-primary-dark">
          Événements privés
        </p>
        <h1 class="reveal mb-4 font-heading text-3xl font-extrabold leading-tight text-primary-dark md:text-5xl" style="--reveal-delay:60ms">
          Votre événement, version street food du potager.
        </h1>
        <p class="reveal mb-6 font-body text-base leading-relaxed text-anthracite/80 md:text-lg" style="--reveal-delay:120ms">
          Mariage, séminaire, fête du personnel ou anniversaire : la remorque Yummy vient jusqu'à vous, où que soit votre
          événement, avec une cuisine végétale, locale et gourmande.
        </p>
        <div class="reveal flex flex-wrap gap-3" style="--reveal-delay:180ms">
          <a href="#devis" class="rounded-full bg-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-dark">
            Demander un devis
          </a>
          <a href={`tel:${contact.telephone.replace(/\s+/g, '')}`} class="rounded-full border-2 border-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary transition-colors hover:bg-primary hover:text-cream">
            {contact.telephone}
          </a>
        </div>
      </div>
      <div class="reveal-scale mx-auto w-full max-w-md overflow-hidden rounded-3xl shadow-2xl">
        <Image
          src={remorquePhoto}
          alt="La remorque Yummy Street Food, hayon ouvert et menu du jour à l'ardoise"
          class="aspect-[4/5] w-full object-cover object-[50%_72%] md:aspect-[5/6]"
          quality={90}
          widths={[400, 800, 1080]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </section>

    <section class="relative z-10 bg-mint/60 py-14">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="reveal mb-8 text-center font-heading text-2xl font-bold text-primary-dark md:text-3xl">Pour quelles occasions ?</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            occasions.map((o, i) => (
              <div class="reveal-scale rounded-2xl bg-white p-5 shadow-md" style={`--reveal-delay:${i * 70}ms`}>
                <p class="mb-2 text-3xl" aria-hidden="true">{o.emoji}</p>
                <h3 class="mb-1 font-heading text-lg font-bold text-primary-dark">{o.titre}</h3>
                <p class="font-body text-sm text-anthracite/75">{o.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="relative z-10 mx-auto max-w-6xl px-4 py-16">
      <h2 class="reveal mb-2 text-center font-heading text-2xl font-bold text-primary-dark md:text-3xl">Une prestation sur mesure</h2>
      <p class="reveal mb-10 text-center font-body text-anthracite/70">Trois formules pour démarrer, à adapter à votre nombre d'invités, à la saison et à votre budget. Tarifs sur devis.</p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          formules.map((f, i) => (
            <article class="reveal-scale flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg" style={`--reveal-delay:${i * 80}ms`}>
              <Image src={f.image} alt={f.alt} class="aspect-[4/3] w-full object-cover" widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
              <div class="flex flex-1 flex-col gap-2 p-5">
                <h3 class="font-heading text-2xl font-bold text-primary-dark">{f.titre}</h3>
                <ul class="flex flex-col gap-2 border-y border-mint py-3">
                  {f.contenu.map((c) => (
                    <li class="flex items-center gap-2 font-body text-base text-anthracite">
                      <span
                        class={`flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-sm font-bold ${c.startsWith('+') ? 'border-2 border-dashed border-primary/50 text-primary' : 'bg-primary text-cream'}`}
                        aria-hidden="true"
                      >
                        {c.startsWith('+') ? '+' : '✓'}
                      </span>
                      <span class={c.startsWith('+') ? 'italic text-anthracite/70' : 'font-semibold'}>{c.replace(/^\+ /, '')}</span>
                    </li>
                  ))}
                </ul>
                <p class="font-body text-sm text-anthracite/80">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="reveal mt-6 text-center font-body text-sm text-anthracite/70">
        Starters seuls pour un vin d'honneur, service en fin de soirée, brunch du lendemain de mariage, lunch pour vos équipes ? Tout est possible : dites-le-nous dans le formulaire.
      </p>
    </section>

    <section class="relative z-10 bg-primary-dark py-14 text-cream">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2">
        <div>
          <h2 class="reveal mb-6 font-heading text-2xl font-bold md:text-3xl">Pourquoi Yummy ?</h2>
          <ul class="flex flex-col gap-3">
            {
              atouts.map((a) => (
                <li class="reveal flex items-start gap-3 font-body">
                  <span class="mt-0.5 text-lime" aria-hidden="true">✔</span>
                  {a}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="reveal mb-6 font-heading text-2xl font-bold md:text-3xl">Comment ça se passe ?</h2>
          <ol class="flex flex-col gap-4">
            {
              etapes.map((e) => (
                <li class="reveal flex gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-lime font-heading font-bold text-primary-dark">{e.n}</span>
                  <div>
                    <p class="font-heading font-bold">{e.titre}</p>
                    <p class="font-body text-sm text-mint">{e.desc}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="relative z-10 mx-auto max-w-3xl px-4 py-16">
      <h2 class="reveal mb-2 text-center font-heading text-2xl font-bold text-primary-dark md:text-3xl">Demandez votre proposition</h2>
      <p class="reveal mb-8 text-center font-body text-anthracite/70">
        Ou appelez-nous au <a class="font-semibold text-primary hover:underline" href={`tel:${contact.telephone.replace(/\s+/g, '')}`}>{contact.telephone}</a>.
      </p>
      <div class="reveal-scale">
        <EventQuoteForm />
      </div>
    </section>
  </div>
</Layout>
