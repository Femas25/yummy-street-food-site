---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ProchainPassage from '../components/ProchainPassage.astro';
import logo from '../assets/brand/logo.png';
import sandwichLegumes from '../assets/menu/sandwich-legumes-truck.jpg';
import pitaLegumes from '../assets/menu/pita-legumes-jardin.jpg';
import bowlAutomne from '../assets/menu/bowl-automne.jpg';
import boulettes from '../assets/menu/boulettes-sauce-yaourt.jpg';
import remorquePhoto from '../assets/truck/remorque-yummy.jpg';
import potagerPhoto from '../assets/gallery/jardin-serre-fleurs.jpg';
import eventPhoto from '../assets/menu/bowls-vegetaux-fleurs.jpg';
import burgerBetterave from '../assets/menu/burger-betterave.jpg';
import pitaGarni from '../assets/menu/pita-garni-sauce-blanche.jpg';
import bowlChili from '../assets/menu/bowl-chili-vegetal.jpg';

// Héros : tout ce qu'on propose, en défilement (vraies photos des plats).
const propositions = [
  { nom: 'Burger', src: burgerBetterave, alt: 'Burger à la betterave, salade et sauce', pos: '50% 55%' },
  { nom: 'Pita', src: pitaGarni, alt: 'Pita garni de protéines végétales, tomate, oignon rouge, salade et sauce blanche', pos: '55% 42%' },
  { nom: 'Chili sin carne', src: bowlChili, alt: 'Chili sin carne : haricots rouges, maïs, riz, sauce crémeuse, coriandre et nachos', pos: '50% 50%' },
  { nom: 'Sur les marchés', src: remorquePhoto, alt: 'Le comptoir de la remorque Yummy Street Food et son menu à l’ardoise', pos: '30% 78%' },
  { nom: 'Bowl', src: eventPhoto, alt: 'Deux bowls végétaux avec couscous, lentilles, radis, tomates et fleurs comestibles', pos: '55% 60%' },
  { nom: 'Pita aux légumes', src: pitaLegumes, alt: 'Pitas garnis de légumes, tomates, oignons rouges, salade et sauce blanche', pos: '50% 50%' },
  { nom: 'Bowl de saison', src: bowlAutomne, alt: 'Bowl de saison garni de légumes, radis et sauce crémeuse', pos: '50% 50%' },
  { nom: 'Bouchées & sauce yaourt', src: boulettes, alt: 'Boulettes végétales en bouchées apéritives, servies avec une sauce au yaourt et aux herbes', pos: '50% 40%' },
  { nom: 'Notre remorque', src: remorquePhoto, alt: 'La remorque verte Yummy Street Food, hayon ouvert, sur un marché', pos: '45% 60%' },
  { nom: 'Street food à emporter', src: sandwichLegumes, alt: 'Pita garnie de légumes, tenue devant la remorque verte Yummy Street Food', pos: '50% 45%' },
];

// Aperçu : 3 plats déjà présentés sur la page « Nos propositions » (nom + description validés, vraie photo du plat).
const apercu = [
  { nom: 'Burger', desc: 'Le burger version végétale', src: burgerBetterave, alt: 'Burger à la betterave, salade et sauce', pos: '50% 55%' },
  { nom: 'Pita', desc: 'Pain pita généreusement garni', src: pitaGarni, alt: 'Pita garni de protéines végétales, tomate, oignon rouge, salade et sauce blanche', pos: '55% 42%' },
  { nom: 'Chili sin carne', desc: 'Haricots rouges, maïs, riz et nachos', src: bowlChili, alt: 'Chili sin carne : haricots rouges, maïs, riz, sauce crémeuse, coriandre et nachos', pos: '50% 50%' },
];
---

<Layout
  title="Accueil"
  fullTitle="Food truck végétal à Virton | Yummy Street Food"
  description="Yummy Street Food, food truck de street food végétale à Virton et en Gaume : prochain passage, menu, événements privés."
>
  <!-- Héros : logo Yummy à gauche, défilement de nos propositions à droite (empilés sur mobile) -->
  <section class="relative isolate overflow-hidden bg-primary-dark text-cream">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(120% 90% at 30% 0%, #159E7B 0%, #0B4A2C 45%, #083E23 100%);"
      aria-hidden="true"
    ></div>
    <div class="container-y grid items-center gap-10 py-12 md:grid-cols-[0.9fr_1.1fr] md:gap-10 md:py-16 lg:py-20">
      <div class="flex flex-col items-center gap-5 text-center md:items-start md:text-left">
        <Image src={logo} alt="Yummy Street Food" width={1500} height={868} class="w-60 max-w-[75vw] drop-shadow-xl md:w-80 lg:w-96" loading="eager" fetchpriority="high" />
        <h1 class="sr-only">Yummy Street Food, street food végétale à Virton et en Gaume</h1>
        <p class="-mt-2 w-60 max-w-[75vw] text-center font-heading text-sm font-bold uppercase tracking-[0.35em] text-mint md:w-80 md:text-base lg:w-96">Food Truck</p>
        <p class="font-body text-base font-semibold text-mint md:text-lg">Local • Végétal • Gourmand</p>
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          <a href="/menu" class="btn-lime">Voir nos propositions</a>
          <a href="/localisation" class="btn-outline-light">Localiser le truck</a>
        </div>
      </div>

      <div class="relative min-w-0">
        <p class="sr-only" id="manege-titre">Nos propositions et notre remorque en images, sur un carrousel 3D qui tourne tout seul : faites-le tourner à la souris ou au doigt, ou avec les flèches du clavier.</p>
        <div id="manege" class="manege" role="region" aria-labelledby="manege-titre" tabindex="0">
          <div class="manege-anneau" id="manege-anneau" style={`--n:${propositions.length}`}>
            {propositions.map((p, i) => (
              <figure class="manege-carte" style={`--i:${i}`}>
                <Image
                  src={p.src}
                  alt={p.alt}
                  class="h-full w-full select-none object-cover"
                  style={`object-position:${p.pos}`}
                  widths={[240, 360, 480]}
                  sizes="(min-width: 1024px) 220px, 150px"
                  loading={i < 4 ? 'eager' : 'lazy'}
                  draggable="false"
                />
                <figcaption>{p.nom}</figcaption>
              </figure>
            ))}
          </div>
          <div class="manege-sol" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .manege { --w: 100px; --h: 136px; position: relative; height: calc(var(--h) + 150px); perspective: 900px; perspective-origin: 50% 0%; cursor: grab; touch-action: pan-y; outline: none; }
    @media (min-width: 640px) { .manege { --w: 140px; --h: 188px; } }
    @media (min-width: 1024px) { .manege { --w: 165px; --h: 220px; perspective: 1200px; } }
    .manege.is-dragging { cursor: grabbing; }
    .manege:focus-visible { box-shadow: 0 0 0 3px #BED70B; border-radius: 1.5rem; }
    .manege-anneau { --r: calc(var(--w) * 0.5 / tan(calc(180deg / var(--n))) + 18px); position: absolute; left: 50%; top: 55px; width: var(--w); height: var(--h); margin-left: calc(var(--w) / -2); transform-style: preserve-3d; transform: rotateX(-14deg) rotateY(0deg); will-change: transform; }
    .manege-carte { position: absolute; inset: 0; margin: 0; overflow: hidden; border-radius: 1.25rem; box-shadow: 0 18px 40px rgba(0,0,0,.35); transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r)); background: #083E23; transition: opacity .2s; }
    .manege-carte.dos figcaption { visibility: hidden; }
    .manege-carte figcaption { position: absolute; inset: auto 0 0 0; padding: 2.25rem .9rem .8rem; background: linear-gradient(to top, rgba(8,62,35,.92), transparent); color: #FAF5EA; font-family: Fredoka, sans-serif; font-weight: 600; font-size: 1rem; line-height: 1.15; }
    .manege-sol { position: absolute; left: 12%; right: 12%; bottom: 22px; height: 46px; border-radius: 50%; background: radial-gradient(closest-side, rgba(0,0,0,.45), transparent); filter: blur(6px); }
  </style>

  <script>
    // Carrousel 3D en cercle : tourne tout seul autour de son axe ; on le fait tourner plus vite en le faisant glisser.
    const scene = document.getElementById('manege');
    const anneau = document.getElementById('manege-anneau');
    if (scene && anneau) {
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const n = Number(getComputedStyle(anneau).getPropertyValue('--n')) || 10;
      const pas = 360 / n;
      let angle = 0, vitesse = reduit ? 0 : -0.12, elan = 0, drag = false, survol = false, dernierX = 0;
      const cartes = [...anneau.querySelectorAll('.manege-carte')];
      const appliquer = () => {
        anneau.style.transform = `rotateX(-14deg) rotateY(${angle}deg)`;
        cartes.forEach((c, i) => {
          const a = ((angle + i * pas) * Math.PI) / 180;
          const face = Math.cos(a); // 1 = devant, -1 = derrière
          c.style.filter = `brightness(${(0.45 + 0.55 * Math.max(face, 0)).toFixed(2)})`;
          c.style.opacity = face < -0.1 ? '0.55' : '1';
          c.classList.toggle('dos', face < 0);
        });
      };
      const boucle = () => {
        if (!drag) {
          if (Math.abs(elan) > 0.02) { angle += elan; elan *= 0.95; }
          else if (!survol) angle += vitesse;
          appliquer();
        }
        requestAnimationFrame(boucle);
      };
      scene.addEventListener('pointerdown', (e) => {
        drag = true; scene.classList.add('is-dragging'); dernierX = e.clientX; elan = 0;
        scene.setPointerCapture(e.pointerId);
      });
      scene.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const dx = e.clientX - dernierX; dernierX = e.clientX;
        const d = dx * 0.35; angle += d; elan = d; appliquer();
      });
      const fin = () => { drag = false; scene.classList.remove('is-dragging'); };
      scene.addEventListener('pointerup', fin); scene.addEventListener('pointercancel', fin);
      scene.addEventListener('mouseenter', () => (survol = true));
      scene.addEventListener('mouseleave', () => (survol = false));
      scene.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { elan = -pas / 12; e.preventDefault(); }
        if (e.key === 'ArrowLeft') { elan = pas / 12; e.preventDefault(); }
      });
      appliquer();
      requestAnimationFrame(boucle);
    }
  </script>

  <!-- Prochain passage + la remorque à repérer -->
  <section class="py-10 md:py-16" aria-label="Où nous trouver">
    <div class="container-y grid items-center gap-8 md:grid-cols-[1.1fr_1fr] md:gap-12">
      <ProchainPassage lienAgenda />
      <div class="flex items-center gap-5 md:flex-col md:items-start">
        <Image
          src={remorquePhoto}
          alt="La remorque Yummy Street Food, hayon ouvert et menu du jour à l'ardoise"
          class="aspect-square w-28 shrink-0 rounded-2xl object-cover object-[40%_62%] sm:w-36 md:aspect-[4/3] md:w-full"
          widths={[240, 480, 800]}
          sizes="(min-width: 768px) 45vw, 144px"
        />
        <div>
          <h2 class="font-heading text-xl font-semibold md:text-2xl">Repérez notre remorque verte</h2>
          <p class="mt-2 font-body text-base leading-relaxed text-muted">
            Sur les marchés et événements, on y revisite les classiques de la street food, en version végétale.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Aperçu du menu -->
  <section class="border-t border-primary-dark/10 py-12 md:py-16" aria-labelledby="apercu-titre">
    <div class="container-y">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="kicker text-primary">Au menu</p>
          <h2 id="apercu-titre" class="mt-1 font-heading text-3xl font-semibold md:text-4xl">Quelques classiques</h2>
        </div>
        <a href="/menu" class="btn-outline btn-sm">Voir le menu</a>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          apercu.map((plat) => (
            <li class="card overflow-hidden">
              <Image
                src={plat.src}
                alt={plat.alt}
                class="aspect-[4/3] w-full object-cover"
                style={`object-position:${plat.pos}`}
                widths={[360, 480, 640, 800]}
                sizes="(min-width: 640px) 33vw, calc(100vw - 2rem)"
                quality={68}
              />
              <div class="p-4">
                <h3 class="font-heading text-xl font-semibold">{plat.nom}</h3>
                <p class="mt-1 font-body text-base text-muted">{plat.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-body text-sm text-muted">Carte variable selon la saison et l'événement.</p>
    </div>
  </section>

  <!-- Potager -->
  <section class="bg-mint py-12 md:py-16" aria-labelledby="potager-titre">
    <div class="container-y grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <Image
        src={potagerPhoto}
        alt="Notre jardin et sa serre, entourés de fleurs"
        class="aspect-[16/9] w-full rounded-3xl object-cover object-[25%_50%] md:aspect-[4/3]"
        widths={[480, 640, 800, 1200]}
        sizes="(min-width: 768px) 50vw, calc(100vw - 2rem)"
        quality={62}
      />
      <div>
        <p class="kicker text-primary-dark">Du potager à l'assiette</p>
        <h2 id="potager-titre" class="mt-1 font-heading text-3xl font-semibold md:text-4xl">Les légumes de saison de notre potager</h2>
        <p class="mt-4 max-w-prose font-body text-lg leading-relaxed text-anthracite">
          Nos recettes suivent les saisons et ce que donne notre potager, avec des produits bio et locaux autant que possible.
        </p>
        <a href="/galerie" class="btn-dark mt-6">Voir le potager et nos récoltes</a>
      </div>
    </div>
  </section>

  <!-- Événements privés -->
  <section class="px-4 py-12 sm:px-6 md:py-16" aria-labelledby="evenements-titre">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-3xl bg-primary-dark">
      <Image
        src={eventPhoto}
        alt=""
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_60%]"
        widths={[480, 800, 1200, 1800]}
        sizes="(min-width: 1152px) 1152px, 100vw"
        quality={60}
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary-dark via-primary-dark/90 to-primary-dark/30 md:via-primary-dark/80"></div>
      <div class="max-w-xl px-6 py-12 text-cream md:px-12 md:py-16">
        <p class="kicker text-lime">Événements privés</p>
        <h2 id="evenements-titre" class="mt-2 font-heading text-3xl font-semibold text-cream md:text-4xl">Un événement à organiser ?</h2>
        <p class="mt-4 font-body text-lg leading-relaxed text-cream">
          Mariages, anniversaires, fêtes d'entreprise, festivals : notre remorque s'installe chez vous et régale vos invités avec une street food végétale faite maison.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/evenements-prives#formules" class="btn-lime">Voir les formules</a>
          <a href="/evenements-prives#devis" class="btn-outline-light">Demander un devis</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
