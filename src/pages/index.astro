---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Leaf from '../components/icons/Leaf.astro';
import Burger from '../components/icons/Burger.astro';
import Wrap from '../components/icons/Wrap.astro';
import Trailer from '../components/icons/Trailer.astro';
import Mail from '../components/icons/Mail.astro';
import Phone from '../components/icons/Phone.astro';
import Instagram from '../components/icons/Instagram.astro';
import Facebook from '../components/icons/Facebook.astro';
import contact from '../data/contact.json';
import remorquePhoto from '../assets/truck/remorque-yummy.jpg';
import champPhoto from '../assets/gallery/jardin-serre-fleurs.jpg';
import eventPhoto from '../assets/menu/bowls-vegetaux-fleurs.jpg';

---

<Layout
  title="Accueil"
  description="Yummy Street Food, food truck végétal, local et gourmand — retrouvez nos prochains passages près de chez vous."
>
  <section class="relative isolate overflow-hidden bg-primary-dark text-cream">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(120% 90% at 50% 0%, #159E7B 0%, #0B4A2C 45%, #083E23 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-90" aria-hidden="true">
      <Leaf class="leaf-deco absolute left-[5%] top-[10%] w-16 opacity-40 md:w-24" style="--rot:-18deg; --float-delay:0s" />
      <Leaf class="leaf-deco absolute right-[3%] top-[36%] w-14 opacity-35 md:w-20" style="--rot:16deg; --float-delay:1.3s" />
      <Leaf class="leaf-deco absolute left-[2%] top-[58%] w-12 opacity-30 md:w-16" style="--rot:8deg; --float-delay:2.4s" />
      <Leaf class="leaf-deco absolute bottom-[4%] left-[42%] w-16 opacity-30 md:w-24" style="--rot:-10deg; --float-delay:0.7s" />
      <Burger class="leaf-deco absolute left-[24%] top-[6%] w-11 opacity-30 sm:w-14 md:w-20" style="--rot:-8deg; --float-delay:1.8s" />
      <Burger class="leaf-deco absolute left-[8%] bottom-[12%] w-9 opacity-25 sm:w-12 md:w-16" style="--rot:14deg; --float-delay:1.1s" />
      <Burger class="leaf-deco absolute right-[4%] bottom-[10%] w-10 opacity-25 sm:w-12 md:w-16" style="--rot:-15deg; --float-delay:2.6s" />
      <Wrap class="leaf-deco absolute left-[4%] top-[34%] w-11 opacity-30 sm:w-14 md:w-20" style="--rot:12deg; --float-delay:0.4s" />
      <Trailer class="leaf-deco absolute right-2 top-5 w-16 opacity-50 sm:w-20 md:right-10 md:top-8 md:w-28" style="--rot:-6deg; --float-delay:0.7s" />
    </div>

    <div class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center gap-7 px-4 py-24 text-center md:min-h-[78vh]">
      <Image src={logo} alt="Yummy Street Food" width={1500} height={868} class="reveal-scale w-64 max-w-[80vw] drop-shadow-xl md:w-96" />
      <h1 class="sr-only">Yummy Street Food</h1>
      <span
        class="reveal inline-block rounded-full border border-cream/30 bg-cream/10 px-4 py-1.5 font-heading text-xs font-bold uppercase tracking-[0.2em] text-mint backdrop-blur-sm md:text-sm"
        style="--reveal-delay:120ms"
      >
        Food Truck
      </span>
      <p class="reveal max-w-xl font-body text-base font-semibold text-mint md:text-lg" style="--reveal-delay:220ms">Local • Végétal • Gourmand</p>
      <div class="reveal flex flex-wrap justify-center gap-4" style="--reveal-delay:320ms">
        <a
          href="/menu"
          class="rounded-full bg-lime px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary-dark shadow-sm transition-all hover:-translate-y-0.5 hover:bg-lime/90 hover:shadow-md"
        >
          Voir nos propositions
        </a>
        <a
          href="/localisation"
          class="rounded-full border-2 border-cream px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream transition-all hover:-translate-y-0.5 hover:bg-cream hover:text-primary-dark hover:shadow-md"
        >
          Localiser le truck
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2 md:items-center md:gap-16">
      <div class="reveal text-center md:order-2 md:text-left">
        <h2 class="mb-6 font-heading text-3xl font-bold text-primary-dark md:text-4xl">Notre remorque.</h2>
        <p class="font-body text-base leading-relaxed text-anthracite/90 md:text-lg">
          Repérez notre remorque verte sur les marchés et événements : on y revisite les classiques de la street food, en version végétale, pour un service convivial et gourmand.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="/menu"
            class="inline-block rounded-full bg-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-lg"
          >
            Voir nos propositions →
          </a>
          <a
            href="/localisation"
            class="inline-block rounded-full border-2 border-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-cream"
          >
            Où nous trouver
          </a>
        </div>
      </div>

      <div class="reveal-scale overflow-hidden rounded-2xl shadow-xl transition-shadow duration-300 hover:shadow-2xl md:order-1">
        <Image
          src={remorquePhoto}
          alt=""
          class="aspect-[4/5] w-full object-cover transition-transform duration-500 hover:scale-105 md:aspect-[3/4]"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2 md:items-center md:gap-16">
      <div class="reveal-scale overflow-hidden rounded-2xl shadow-xl transition-shadow duration-300 hover:shadow-2xl md:order-2">
        <Image
          src={champPhoto}
          alt="Vue d'ensemble de notre jardin et de sa serre, entourés de fleurs"
          class="aspect-[4/5] w-full object-cover saturate-[1.15] contrast-[1.05] transition-transform duration-500 hover:scale-105 md:aspect-[3/4]"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>

      <div class="reveal text-center md:order-1 md:text-left" style="--reveal-delay:150ms">
        <h2 class="mb-6 font-heading text-3xl font-bold text-primary-dark md:text-4xl">Du champ à votre assiette.</h2>
        <p class="font-body text-base leading-relaxed text-anthracite/90 md:text-lg">
          Chez Yummy Street Food, nous cultivons nous-mêmes la majorité des légumes qui composent nos recettes.
          Récoltés à maturité, sans traitements et dans le respect de la nature, ils arrivent directement
          dans votre assiette. Une cuisine locale, sincère et pleine de goût.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="/menu"
            class="inline-block rounded-full bg-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-lg"
          >
            Voir nos propositions →
          </a>
          <a
            href="/localisation"
            class="inline-block rounded-full border-2 border-primary px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-cream"
          >
            Où nous trouver
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-20 md:py-28">
    <div class="reveal-scale relative isolate mx-auto max-w-6xl overflow-hidden rounded-3xl shadow-2xl">
      <Image
        src={eventPhoto}
        alt="Bowls végétaux servis pour un événement"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        widths={[600, 1200, 1800]}
        sizes="(min-width: 1152px) 1152px, 100vw"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary-dark/90 via-primary-dark/70 to-primary-dark/20"></div>
      <div class="max-w-xl px-6 py-16 text-center text-cream md:px-14 md:py-24 md:text-left">
        <span class="mb-4 inline-block rounded-full bg-lime px-4 py-1.5 font-heading text-xs font-bold uppercase tracking-[0.2em] text-primary-dark">Événements privés</span>
        <h2 class="mb-5 font-heading text-3xl font-bold md:text-4xl">Un événement à organiser ?</h2>
        <p class="mb-8 font-body text-base leading-relaxed text-cream/90 md:text-lg">
          Mariages, anniversaires, fêtes d'entreprise, festivals : notre remorque s'installe chez vous et régale vos invités avec une street food végétale faite maison.
        </p>
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="/evenements-prives"
            class="inline-block rounded-full bg-lime px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-primary-dark shadow-sm transition-all hover:-translate-y-0.5 hover:bg-lime/90 hover:shadow-md"
          >
            Demander un devis →
          </a>
          <a
            href="/evenements-prives"
            class="inline-block rounded-full border-2 border-cream px-6 py-3 font-heading text-sm font-bold uppercase tracking-wide text-cream transition-all hover:-translate-y-0.5 hover:bg-cream hover:text-primary-dark"
          >
            Nos formules
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-primary-dark py-14 text-cream">
    <div class="reveal mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center">
      <h2 class="font-heading text-xl font-bold">Retrouvez-nous aussi ici</h2>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 font-body text-sm text-mint">
        <a href={`mailto:${contact.email}`} class="flex items-center gap-1.5 hover:text-lime hover:underline">
          <Mail class="h-4 w-4 shrink-0" />
          {contact.email}
        </a>
        <a href={`tel:${contact.telephone.replace(/\s+/g, '')}`} class="flex items-center gap-1.5 hover:text-lime hover:underline">
          <Phone class="h-4 w-4 shrink-0" />
          {contact.telephone}
        </a>
        <a href={contact.reseaux.instagramUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-lime hover:underline">
          <Instagram class="h-4 w-4 shrink-0" />
          {contact.reseaux.instagram}
        </a>
        <a href={contact.reseaux.facebookUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-lime hover:underline">
          <Facebook class="h-4 w-4 shrink-0" />
          {contact.reseaux.facebook}
        </a>
      </div>
    </div>
  </section>
</Layout>
