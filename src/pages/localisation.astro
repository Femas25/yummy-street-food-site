---
import Layout from '../layouts/Layout.astro';
import ProchainPassage from '../components/ProchainPassage.astro';
import planning from '../data/planning.json';
import {
  tousLesPassages,
  passagesAVenir,
  dateLongue,
  moisAnnee,
  jourRelatif,
  itineraire,
  lienPlans,
  lienWaze,
  schemaEvenement,
  type Passage,
} from '../lib/agenda';

// Une seule source : src/data/evenements.json (lu par src/lib/agenda.ts), comme la carte « Prochain passage »
// de l'accueil et les données schema.org ci-dessous. Champs facultatifs par événement :
// « commune » (sinon lue dans l'adresse) et « statut »: "annulé" (affiché barré, sans itinéraire).
const maintenant = Date.now();
const site = new URL('/', Astro.site).toString();
const passages = tousLesPassages();
const aVenir = passagesAVenir(maintenant, passages);

// Regroupement par mois puis par jour (plusieurs passages possibles le même jour).
const mois: { cle: string; label: string; jours: { date: string; passages: Passage[] }[] }[] = [];
for (const p of aVenir) {
  const cle = p.date.slice(0, 7);
  let m = mois.find((x) => x.cle === cle);
  if (!m) mois.push((m = { cle, label: moisAnnee(p.date), jours: [] }));
  let j = m.jours.find((x) => x.date === p.date);
  if (!j) m.jours.push((j = { date: p.date, passages: [] }));
  j.passages.push(p);
}

// Pour Google : uniquement les passages publics à venir (l'entreprise est décrite à part dans le Layout).
const eventsSchema = aVenir.filter((p) => !p.prive && p.adresse).map((p) => schemaEvenement(p, site));

// Calendrier : tout l'historique.
const couleurs: Record<string, string> = {
  primary: 'bg-primary',
  leaf: 'bg-leaf',
  lime: 'bg-lime',
  red: 'bg-red-600',
  noel: 'bg-red-600',
};
const eventsForCalendar = passages.map((p) => ({
  date: p.date,
  titre: p.titre,
  lieu: p.lieu,
  commune: p.commune ?? '',
  adresse: p.adresse ?? '',
  horaires: p.horaires,
  couleur: p.couleur,
  annule: p.annule,
  prive: p.prive,
  dateFormatted: dateLongue(p.date, 0),
}));

const hasProchainsPassages = planning.prochains_passages.length > 0;
---

<Layout
  title="Où nous trouver"
  description="Agenda du food truck Yummy Street Food : prochains marchés et événements à Virton, Arlon et en Gaume, avec horaires et itinéraire."
>
  <section class="bg-primary-dark text-cream">
    <div class="container-y py-10 md:py-12">
      <p class="kicker text-lime">Agenda</p>
      <h1 class="mt-2 font-heading text-4xl font-semibold text-cream md:text-5xl">Où nous trouver</h1>
      <p class="mt-3 max-w-prose font-body text-lg text-mint">Nos prochains marchés et événements publics, avec horaires et itinéraire.</p>
    </div>
  </section>

  <div class="container-y py-8 md:py-12">
    <ProchainPassage class="mx-auto max-w-3xl lg:mx-0" />

    <div class="mt-10 flex flex-col gap-10 lg:grid lg:grid-cols-[380px_1fr] lg:items-start lg:gap-12">
      <!-- Liste chronologique (avant la grille sur mobile) -->
      <section aria-labelledby="liste-titre" class="lg:col-start-2 lg:row-start-1">
        <h2 id="liste-titre" class="font-heading text-2xl font-semibold md:text-3xl">Toutes les dates à venir</h2>

        <p data-agenda-vide hidden={aVenir.length > 0} class="card mt-5 p-5 font-body text-base text-muted">
          Aucun passage annoncé pour le moment.
        </p>

        <div class="mt-5 flex flex-col gap-8">
          {
            mois.map((m) => (
              <div data-mois>
                <h3 class="kicker border-b border-primary-dark/15 pb-2 capitalize text-primary">{m.label}</h3>
                <ol class="mt-4 flex flex-col gap-5">
                  {m.jours.map((j) => (
                    <li data-jour>
                      <p class="mb-2 font-heading text-lg font-semibold first-letter:uppercase text-primary-dark">{dateLongue(j.date, maintenant)}</p>
                      <ul class="flex flex-col gap-3">
                        {j.passages.map((p) => {
                          const rel = jourRelatif(p, maintenant);
                          return (
                            <li
                              data-passage
                              data-date={p.date}
                              data-debut={p.debut}
                              data-fin={p.fin}
                              class={`card border-l-4 p-4 sm:p-5 ${p.annule ? 'border-red-700' : p.prive ? 'border-muted/40' : 'border-primary'}`}
                            >
                              <article>
                                <div class="flex flex-wrap items-center gap-2">
                                  {p.commune && <p class="kicker text-primary">{p.commune}</p>}
                                  <span data-badge hidden={!rel || p.annule} class="rounded-full bg-lime px-2.5 py-0.5 font-heading text-xs font-semibold uppercase tracking-wide text-primary-dark">{rel}</span>
                                  {p.annule && <span class="rounded-full bg-red-700 px-2.5 py-0.5 font-heading text-xs font-semibold uppercase tracking-wide text-white">Annulé</span>}
                                </div>
                                <h4 class={`mt-1 font-heading text-xl font-semibold ${p.annule ? 'line-through decoration-2' : ''}`}>{p.titre}</h4>
                                {!p.prive && <p class="mt-1 font-body text-base text-anthracite">{p.lieu}</p>}
                                <p class="mt-1 font-body text-base font-semibold text-anthracite">
                                  {p.prive ? 'Événement privé, non ouvert au public' : p.horaires}
                                  {p.finApresMinuit && <span class="font-normal text-muted"> (se termine le lendemain)</span>}
                                </p>
                                {p.annule && <p class="mt-1 font-body text-sm text-red-800">Ce passage est annulé.</p>}
                                {p.adresse && !p.annule && !p.prive && (
                                  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <a href={itineraire(p.adresse)} rel="noopener" class="btn-dark btn-sm">
                                      Itinéraire
                                    </a>
                                    <span class="font-body text-sm text-muted">
                                      ou{' '}
                                      <a href={lienPlans(p.adresse)} rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1">Plans</a>
                                      ·
                                      <a href={lienWaze(p.adresse)} rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1">Waze</a>
                                    </span>
                                  </div>
                                )}
                              </article>
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Calendrier (après la liste sur mobile, colonne de gauche sur ordinateur) -->
      <section aria-labelledby="cal-titre" class="lg:sticky lg:top-28 lg:col-start-1 lg:row-start-1">
        <h2 id="cal-titre" class="sr-only">Calendrier</h2>
        <div class="card p-4 sm:p-6">
          <div class="mb-3 flex items-center justify-between">
            <button id="cal-prev" type="button" aria-label="Mois précédent" class="flex h-11 w-11 items-center justify-center rounded-full bg-mint font-heading text-xl text-primary-dark hover:bg-primary-dark hover:text-cream">‹</button>
            <p id="cal-label" aria-live="polite" class="font-heading text-xl font-semibold capitalize text-primary-dark">—</p>
            <button id="cal-next" type="button" aria-label="Mois suivant" class="flex h-11 w-11 items-center justify-center rounded-full bg-mint font-heading text-xl text-primary-dark hover:bg-primary-dark hover:text-cream">›</button>
          </div>
          <div class="mb-1 grid grid-cols-7 gap-1 text-center font-heading text-xs font-semibold uppercase text-muted" aria-hidden="true">
            <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
          </div>
          <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-primary-dark/10 pt-3 font-body text-sm text-muted">
            <p class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>Jour avec un passage</p>
            <p class="flex items-center gap-2"><span class="h-3 w-3 rounded border-2 border-primary-dark" aria-hidden="true"></span>Aujourd'hui</p>
          </div>
        </div>
      </section>
    </div>

    {
      hasProchainsPassages && (
        <section class="mt-12" aria-labelledby="reguliers-titre">
          <h2 id="reguliers-titre" class="font-heading text-2xl font-semibold">Nos emplacements réguliers</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {planning.prochains_passages.map((p: { jour: string; lieu: string; horaires: string }) => (
              <li class="card flex flex-col gap-1 border-l-4 border-primary p-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-heading text-lg font-semibold text-primary-dark">{p.jour}</p>
                  <p class="font-body text-base text-anthracite">{p.lieu}</p>
                </div>
                <span class="font-body font-semibold">{p.horaires}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <div id="event-modal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-anthracite/60 p-4" role="dialog" aria-modal="true" aria-labelledby="event-modal-title">
    <div id="event-modal-card" class="relative max-h-[90vh] w-full max-w-sm overflow-y-auto rounded-2xl bg-paper p-6 shadow-2xl">
      <button id="event-modal-close" type="button" aria-label="Fermer" class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-full bg-mint text-primary-dark hover:bg-primary-dark hover:text-cream">✕</button>
      <p id="event-modal-date" class="mb-1 pr-12 font-heading text-sm font-semibold first-letter:uppercase text-primary"></p>
      <h3 id="event-modal-title" class="mb-4 pr-10 font-heading text-xl font-semibold"></h3>
      <dl class="flex flex-col gap-3 font-body text-base">
        <div><dt class="text-sm font-semibold text-muted">Lieu</dt><dd id="event-modal-lieu"></dd></div>
        <div><dt class="text-sm font-semibold text-muted">Horaires</dt><dd id="event-modal-horaires"></dd></div>
      </dl>
      <p id="event-modal-annule" hidden class="mt-3 rounded-lg bg-red-50 px-3 py-2 font-body text-sm font-semibold text-red-800">Ce passage est annulé.</p>
      <div id="event-modal-links" class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1">
        <a id="event-modal-maps-google" href="#" rel="noopener" class="btn-dark btn-sm">Itinéraire</a>
        <span class="font-body text-sm text-muted">ou <a id="event-modal-maps-apple" href="#" rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1">Plans</a> · <a id="event-modal-maps-waze" href="#" rel="noopener" class="lien inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1">Waze</a></span>
      </div>
      <div id="event-modal-others" hidden class="mt-5 flex flex-col gap-2 border-t border-primary-dark/10 pt-4"></div>
    </div>
  </div>

  {eventsSchema.map((schema) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />)}
</Layout>

<script>
  // Liste : masque dans le navigateur les passages terminés depuis la dernière mise en ligne
  // (une sortie en cours reste visible jusqu'à sa fin, même après minuit) et met à jour les badges.
  import { jourBruxelles } from '../lib/agenda';

  const majListe = () => {
    const maintenant = Date.now();
    const auj = jourBruxelles(maintenant);
    const demain = jourBruxelles(maintenant + 24 * 3600 * 1000);
    let visibles = 0;
    document.querySelectorAll<HTMLElement>('[data-passage]').forEach((el) => {
      const debut = Number(el.dataset.debut);
      const fin = Number(el.dataset.fin);
      const fini = fin <= maintenant;
      el.hidden = fini;
      if (!fini) visibles++;
      const badge = el.querySelector<HTMLElement>('[data-badge]');
      if (badge && !el.querySelector('.line-through')) {
        const txt = debut <= maintenant ? 'En ce moment' : el.dataset.date === auj ? "Aujourd'hui" : el.dataset.date === demain ? 'Demain' : '';
        badge.textContent = txt;
        badge.hidden = !txt;
      }
    });
    document.querySelectorAll<HTMLElement>('[data-jour], [data-mois]').forEach((g) => {
      g.hidden = !g.querySelector('[data-passage]:not([hidden])');
    });
    const vide = document.querySelector<HTMLElement>('[data-agenda-vide]');
    if (vide) vide.hidden = visibles > 0;
  };
  majListe();
  setInterval(majListe, 60_000);
</script>

<script define:vars={{ eventsForCalendar, couleurs }}>
  const grid = document.getElementById('cal-grid');
  const label = document.getElementById('cal-label');
  const prevBtn = document.getElementById('cal-prev');
  const nextBtn = document.getElementById('cal-next');

  const eventsByDate = new Map();
  eventsForCalendar.forEach((e) => {
    if (!eventsByDate.has(e.date)) eventsByDate.set(e.date, []);
    eventsByDate.get(e.date).push(e);
  });

  const modal = document.getElementById('event-modal');
  const modalCard = document.getElementById('event-modal-card');
  const modalClose = document.getElementById('event-modal-close');
  const $ = (id) => document.getElementById(id);
  let declencheur = null;

  const enc = encodeURIComponent;

  function openEventModal(event, sameDay, trigger) {
    if (trigger) declencheur = trigger;
    $('event-modal-date').textContent = event.dateFormatted;
    $('event-modal-title').textContent = event.titre;
    $('event-modal-lieu').textContent = event.prive ? 'Événement privé, non ouvert au public' : event.lieu;
    $('event-modal-horaires').textContent = event.horaires;
    $('event-modal-annule').hidden = !event.annule;
    const liens = $('event-modal-links');
    liens.hidden = !event.adresse || event.annule || event.prive;
    if (event.adresse) {
      $('event-modal-maps-google').href = `https://www.google.com/maps/dir/?api=1&destination=${enc(event.adresse)}`;
      $('event-modal-maps-apple').href = `https://maps.apple.com/?daddr=${enc(event.adresse)}`;
      $('event-modal-maps-waze').href = `https://www.waze.com/ul?q=${enc(event.adresse)}&navigate=yes`;
    }
    const others = $('event-modal-others');
    others.innerHTML = '';
    const autres = sameDay.filter((e) => e !== event);
    others.hidden = autres.length === 0;
    if (autres.length) {
      const h = document.createElement('p');
      h.className = 'font-heading text-sm font-semibold text-muted';
      h.textContent = 'Aussi ce jour-là';
      others.appendChild(h);
      autres.forEach((other) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'min-h-[44px] rounded-xl border-2 border-primary/30 px-3 py-2 text-left font-body text-base text-primary-dark hover:bg-mint';
        btn.textContent = `${other.titre} — ${other.horaires}`;
        btn.addEventListener('click', () => {
          openEventModal(other, sameDay);
          modalClose.focus();
        });
        others.appendChild(btn);
      });
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
    modalClose.focus();
  }

  const isOpen = () => !modal.classList.contains('hidden');

  function closeEventModal() {
    if (!isOpen()) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
    declencheur?.focus();
  }

  modalClose.addEventListener('click', closeEventModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeEventModal();
  });
  window.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') closeEventModal();
    if (e.key === 'Tab') {
      // Garde le focus dans la fenêtre.
      const f = [...modalCard.querySelectorAll('button, a[href]')].filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Aujourd'hui en heure belge.
  const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Brussels' }).format(new Date());
  let viewYear = Number(todayIso.slice(0, 4));
  let viewMonth = Number(todayIso.slice(5, 7)) - 1;
  const pad = (n) => String(n).padStart(2, '0');

  function render() {
    const first = new Date(viewYear, viewMonth, 1);
    const startOffset = (first.getDay() + 6) % 7; // lundi en premier
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
    const nomMois = first.toLocaleDateString('fr-BE', { month: 'long' });
    label.textContent = first.toLocaleDateString('fr-BE', { month: 'long', year: 'numeric' });
    grid.innerHTML = '';

    for (let i = 0; i < startOffset; i++) grid.appendChild(document.createElement('div'));

    for (let d = 1; d <= daysInMonth; d++) {
      const iso = `${viewYear}-${pad(viewMonth + 1)}-${pad(d)}`;
      const isToday = iso === todayIso;
      const dayEvents = eventsByDate.get(iso) ?? [];
      const event = dayEvents.find((e) => !e.annule) ?? dayEvents[0];

      const cell = document.createElement(event ? 'button' : 'div');
      cell.textContent = String(d);
      cell.className = 'relative flex h-11 items-center justify-center rounded-lg font-body text-sm';
      if (isToday) cell.classList.add('border-2', 'border-primary-dark', 'font-bold', 'text-primary-dark');
      else cell.classList.add('text-anthracite');

      if (event) {
        cell.type = 'button';
        cell.classList.add('bg-mint', 'font-bold', 'text-primary-dark', 'hover:bg-primary-dark', 'hover:text-cream');
        const dayTitle = dayEvents.map((e) => `${e.titre}${e.annule ? ' (annulé)' : ''}`).join(' + ');
        cell.setAttribute('aria-label', `${d} ${nomMois} : ${dayTitle}`);
        cell.setAttribute('aria-haspopup', 'dialog');
        cell.title = dayTitle;
        const dot = document.createElement('span');
        dot.setAttribute('aria-hidden', 'true');
        dot.className = `absolute bottom-1 h-1.5 w-1.5 rounded-full ${event.annule ? 'bg-muted' : couleurs[event.couleur] ?? couleurs.primary}`;
        cell.appendChild(dot);
        cell.addEventListener('click', () => openEventModal(dayEvents[0], dayEvents, cell));
      }
      grid.appendChild(cell);
    }
  }

  prevBtn.addEventListener('click', () => {
    viewMonth -= 1;
    if (viewMonth < 0) {
      viewMonth = 11;
      viewYear -= 1;
    }
    render();
  });
  nextBtn.addEventListener('click', () => {
    viewMonth += 1;
    if (viewMonth > 11) {
      viewMonth = 0;
      viewYear += 1;
    }
    render();
  });
  render();
</script>
